---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
const avatarUrl = 'https://github.com/JimmyZhu1420.png?size=120';
---

<footer class="footer">
  <div class="site-wrapper">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/"><img src={avatarUrl} alt="" width="40" height="40" /><span>{profile.name}</span></a>
        <p>AI Agent 学习者 · 开发者</p>
      </div>
      <nav aria-label="页脚导航"><a href="/blog">文章</a><a href="/projects">项目</a><a href="/about">关于</a><a href="/rss.xml">RSS</a></nav>
      <a class="github" href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
    <div class="footer-bottom"><p>© {year} {profile.name}. All rights reserved.</p><span>Built with Astro</span></div>
  </div>
</footer>

<style>
  .footer { margin-top: auto; border-top: 1px solid var(--hairline); padding: 3rem 0 2rem; }
  .footer-content { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; border-bottom: 1px solid var(--hairline); padding-bottom: 2rem; }
  .footer-brand a { display: inline-flex; align-items: center; gap: .65rem; color: var(--page-text); font-weight: 700; text-decoration: none; }
  .footer-brand img { width: 2.5rem; height: 2.5rem; border: 2px solid var(--hairline); border-radius: 50%; object-fit: cover; }
  .footer-brand p { margin-top: .55rem; color: var(--muted-text); font-size: .78rem; }
  nav { display: flex; flex-wrap: wrap; gap: .25rem; }
  nav a { border-radius: var(--radius-lg); color: var(--muted-text); padding: .5rem .7rem; font-size: .78rem; text-decoration: none; }
  nav a:hover { color: var(--page-text); background: var(--surface-soft); }
  .github { border-radius: 999px; color: var(--primary); padding: .55rem .8rem; font-size: .75rem; font-weight: 650; text-decoration: none; }
  .github:hover { background: var(--surface-soft); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; color: var(--muted-text); font-size: .68rem; }
  @media (max-width: 700px) { .footer-content { align-items: center; flex-direction: column; } .footer-bottom { align-items: flex-start; flex-direction: column; } }
</style>
