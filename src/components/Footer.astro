---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer-shell">
  <div class="footer-inner">
    <section class="footer-note" aria-labelledby="footer-title">
      <div>
        <p class="note-mark" aria-hidden="true">✦</p>
        <h2 id="footer-title">如果你也在做 Agent，欢迎来聊聊。</h2>
        <p>项目、实习机会，或者一个还没想清楚的工程问题，都可以从一封邮件开始。</p>
      </div>
      <div class="contact-links">
        <a href={`mailto:${profile.email}`}>写封邮件 <span aria-hidden="true">→</span></a>
        <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <div class="footer-bottom">
      <p>© {year} {profile.name} · 用 Astro 慢慢搭建</p>
      <nav aria-label="页脚导航">
        <a href="/rss.xml">RSS</a>
        <a href="/about">关于</a>
        <a href={`mailto:${profile.email}`}>邮箱</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-shell { margin-top: clamp(5rem, 10vw, 9rem); }
  .footer-inner { width: 100%; max-width: 72rem; margin-inline: auto; padding: 0 1.25rem; }
  .footer-note { display: flex; align-items: end; justify-content: space-between; gap: 3rem; border-top: 1px solid var(--hairline); padding: clamp(3.5rem, 7vw, 5.5rem) 0; }
  .footer-note > div:first-child { max-width: 39rem; }
  .note-mark { color: var(--color-primary-600); font-size: 1.1rem; transform: rotate(10deg); }
  .footer-note h2 { max-width: 18ch; margin-top: .8rem; font-size: clamp(1.75rem, 3.8vw, 3rem); font-weight: 710; letter-spacing: -.045em; line-height: 1.18; }
  .footer-note p:not(.note-mark) { max-width: 36rem; margin-top: .9rem; color: var(--muted-text); font-size: .86rem; line-height: 1.85; }
  .contact-links { display: flex; flex: none; flex-wrap: wrap; gap: .7rem; }
  .contact-links a { display: inline-flex; min-height: 2.7rem; align-items: center; gap: .4rem; border-bottom: 1px solid currentColor; color: var(--page-text); font-size: .78rem; font-weight: 680; text-decoration: none; }
  .contact-links a:first-child { border: 0; border-radius: .75rem; color: #fff; background: #24221f; padding: 0 .95rem; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--hairline); padding: 1.35rem 0 2rem; color: var(--muted-text); font-size: .68rem; }
  .footer-bottom nav { display: flex; gap: 1rem; }
  .footer-bottom a { color: inherit; text-underline-offset: .2rem; }
  .footer-bottom a:hover { color: var(--page-text); }
  :global(.dark) .contact-links a:first-child { color: #211f1b; background: #f5f1e8; }
  @media (max-width: 700px) { .footer-note { align-items: flex-start; flex-direction: column; } .footer-bottom { align-items: flex-start; flex-direction: column; } }
</style>
