---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer-shell">
  <div class="footer-inner">
    <section class="contact-panel" aria-labelledby="contact-title">
      <div>
        <p class="eyebrow">LET'S BUILD RELIABLE AGENTS</p>
        <h2 id="contact-title">对 Agent 工程、项目或实习机会感兴趣？</h2>
        <p>欢迎聊聊工具调用、RAG、评测，或者任何值得被做成真实系统的问题。</p>
      </div>
      <div class="contact-actions">
        <a class="primary" href={`mailto:${profile.email}`}>发邮件 <span aria-hidden="true">→</span></a>
        <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <div class="footer-bottom">
      <p>© {year} {profile.name} · Built with Astro</p>
      <nav aria-label="页脚导航">
        <a href="/rss.xml">RSS</a>
        <a href={profile.resumeUrl}>简历</a>
        <a href={`mailto:${profile.email}`}>邮箱</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-shell { margin-top: clamp(4rem, 9vw, 8rem); border-top: 1px solid var(--hairline); }
  .footer-inner { width: 100%; max-width: 72rem; margin-inline: auto; padding: 0 1.25rem; }
  .contact-panel { display: flex; align-items: flex-end; justify-content: space-between; gap: 2.5rem; padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .contact-panel > div:first-child { max-width: 43rem; }
  .contact-panel h2 { max-width: 17ch; margin-top: 0.8rem; font-size: clamp(1.8rem, 4vw, 3.25rem); font-weight: 760; letter-spacing: -0.045em; line-height: 1.14; }
  .contact-panel p:not(.eyebrow) { max-width: 36rem; margin-top: 1rem; color: var(--muted-text); font-size: 0.95rem; line-height: 1.8; }
  .contact-actions { display: flex; flex: none; flex-wrap: wrap; gap: 0.75rem; }
  .contact-actions a { display: inline-flex; min-height: 2.85rem; align-items: center; gap: 0.45rem; border: 1px solid var(--hairline); border-radius: 999px; padding: 0 1.05rem; color: var(--page-text); background: var(--surface); font-size: 0.84rem; font-weight: 650; text-decoration: none; transition: transform 160ms ease, border-color 160ms ease; }
  .contact-actions a:hover { transform: translateY(-0.15rem); border-color: #9a90ff; }
  .contact-actions .primary { border-color: #111827; color: #fff; background: #111827; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--hairline); padding: 1.5rem 0 2.25rem; color: var(--muted-text); font-size: 0.72rem; }
  .footer-bottom nav { display: flex; gap: 1rem; }
  .footer-bottom a { color: inherit; text-decoration: none; }
  .footer-bottom a:hover { color: var(--page-text); }
  :global(.dark) .contact-actions .primary { border-color: #f8fafc; color: #111827; background: #f8fafc; }

  @media (max-width: 720px) {
    .contact-panel { align-items: flex-start; flex-direction: column; }
    .footer-bottom { align-items: flex-start; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-actions a { transition: none; }
  }
</style>
