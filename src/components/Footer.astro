---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="site-wrapper">
    <div class="footer-top">
      <a class="footer-brand" href="/">{profile.name}</a>
      <nav aria-label="页脚导航"><a href="/projects">项目</a><a href="/blog">文章</a><a href="/about">关于</a><a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav>
    </div>
    <div class="footer-bottom"><p>© {year} {profile.name}</p><span>Designed and built with Astro.</span></div>
  </div>
</footer>

<style>
  .footer { margin-top: auto; color: var(--muted-text); background: var(--surface-soft); padding: 2.25rem 0 1.75rem; }
  .footer-top { display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-bottom: 1px solid var(--hairline); padding-bottom: 1.35rem; }
  .footer-brand { color: var(--page-text); font-size: .78rem; font-weight: 600; text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  nav a { color: var(--muted-text); font-size: .72rem; text-decoration: none; transition: color .2s ease; }
  nav a:hover { color: var(--primary); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.15rem; font-size: .68rem; letter-spacing: 0; }
  .footer-bottom p { margin: 0; }
  @media (max-width: 640px) {
    .footer-top, .footer-bottom { align-items: flex-start; flex-direction: column; }
    nav { gap: 1rem; }
  }
</style>
