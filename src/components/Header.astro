---
import { navItems, profile } from '../data/profile';
interface Props { active?: string; }
const { active } = Astro.props;
---

<header class="site-header" data-site-header>
  <nav class="nav-inner" aria-label="主导航">
    <a class="brand" href="/" aria-label={`${profile.brandName}，返回首页`}>
      <span class="brand-mark" aria-hidden="true">J</span>
      <span>{profile.brandName}</span>
    </a>

    <div id="nav-menu" class="nav-menu">
      <ul>
        {navItems.map((item) => (
          <li><a class:list={[active === item.href && 'active']} aria-current={active === item.href ? 'page' : undefined} href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="nav-actions">
      <a class="github-link" href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <span class="nav-divider" aria-hidden="true"></span>
      <button class="theme-button" type="button" data-theme-toggle aria-label="切换到深色模式">
        <span class="theme-icon" aria-hidden="true"></span>
        <span class="theme-label" data-theme-label aria-hidden="true">深色</span>
      </button>
      <button class="menu-button" type="button" data-menu-toggle aria-label="打开导航菜单" aria-expanded="false" aria-controls="nav-menu"><span></span><span></span></button>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('nav-menu');
  const closeMenu = () => {
    menu?.classList.remove('open');
    menuButton?.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', '打开导航菜单');
  };
  menuButton?.addEventListener('click', () => {
    const open = !menu?.classList.contains('open');
    menu?.classList.toggle('open', open);
    menuButton.classList.toggle('open', open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !menu?.classList.contains('open')) return;
    closeMenu();
    menuButton?.focus();
  });

  const desktopNav = window.matchMedia('(min-width: 701px)');
  desktopNav.addEventListener('change', (event) => { if (event.matches) closeMenu(); });

  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = document.querySelector<HTMLElement>('[data-theme-label]');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  let themeSwitching = false;

  const syncThemeControl = () => {
    const isDark = root.dataset.theme === 'dark';
    const nextLabel = isDark ? '浅色' : '深色';
    themeButton?.setAttribute('aria-label', `切换到${nextLabel}模式`);
    themeButton?.setAttribute('title', `切换到${nextLabel}模式`);
    if (themeLabel) themeLabel.textContent = nextLabel;
    themeColor?.setAttribute('content', isDark ? '#0b0b0d' : '#f5f5f7');
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    try { localStorage.setItem('site-theme', theme); } catch {}
    syncThemeControl();
  };

  themeButton?.addEventListener('click', () => {
    if (themeSwitching) return;
    const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const viewTransitionDocument = document as Document & {
      startViewTransition?: (update: () => void) => { finished: Promise<unknown> };
    };

    if (!reduceMotion && viewTransitionDocument.startViewTransition) {
      const rect = themeButton.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.style.setProperty('--theme-x', `${x}px`);
      root.style.setProperty('--theme-y', `${y}px`);
      root.style.setProperty('--theme-radius', `${radius}px`);
      themeSwitching = true;
      const transition = viewTransitionDocument.startViewTransition(() => applyTheme(nextTheme));
      transition.finished.finally(() => { themeSwitching = false; });
      return;
    }

    applyTheme(nextTheme);
  });

  syncThemeControl();
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 9999;
    inset: 0 0 auto;
    height: 52px;
    border-bottom: 1px solid rgb(255 255 255 / .07);
    color: rgb(255 255 255 / .9);
    background: rgb(8 8 10 / .74);
    box-shadow: 0 1px 0 rgb(0 0 0 / .18);
    backdrop-filter: saturate(180%) blur(24px);
    transition: background .35s ease, border-color .35s ease, box-shadow .35s ease;
  }
  .site-header.is-scrolled { border-color: rgb(255 255 255 / .1); background: rgb(8 8 10 / .9); box-shadow: 0 10px 36px rgb(0 0 0 / .2); }
  .nav-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(100% - 2rem, 72rem); height: 100%; margin: 0 auto; }
  .brand { display: inline-flex; width: max-content; align-items: center; gap: .55rem; color: #f5f5f7; font-size: .78rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; }
  .brand-mark { position: relative; display: grid; width: 1.45rem; height: 1.45rem; place-items: center; overflow: hidden; border: 1px solid rgb(255 255 255 / .16); border-radius: 50%; color: #f5f5f7; background: linear-gradient(145deg, rgb(255 255 255 / .16), rgb(255 255 255 / .045)); box-shadow: inset 0 1px 0 rgb(255 255 255 / .16); font: 600 .58rem/1 var(--font-mono); }
  .brand-mark::after { position: absolute; top: -20%; bottom: -20%; left: -70%; width: 42%; background: linear-gradient(90deg, transparent, rgb(255 255 255 / .48), transparent); content: ''; transform: skewX(-18deg); animation: brand-glint 6s 1.5s var(--ease-premium) infinite; }
  .nav-menu { border: 1px solid rgb(255 255 255 / .07); border-radius: 999px; background: rgb(255 255 255 / .045); padding: .18rem; box-shadow: inset 0 1px 0 rgb(255 255 255 / .05); }
  .nav-menu ul { display: flex; align-items: center; gap: .08rem; margin: 0; padding: 0; list-style: none; }
  .nav-menu a { display: block; border-radius: 999px; color: rgb(255 255 255 / .58); padding: .42rem .82rem; font-size: .69rem; font-weight: 450; letter-spacing: .01em; text-decoration: none; transition: color .25s ease, background .25s ease, box-shadow .25s ease; }
  .nav-menu a:hover { color: rgb(255 255 255 / .92); background: rgb(255 255 255 / .055); }
  .nav-menu a.active { color: #fff; background: rgb(255 255 255 / .11); box-shadow: inset 0 1px 0 rgb(255 255 255 / .09), 0 4px 12px rgb(0 0 0 / .14); }
  .nav-actions { display: flex; align-items: center; justify-content: flex-end; gap: .65rem; }
  .github-link { color: rgb(255 255 255 / .64); font-size: .69rem; text-decoration: none; transition: color .25s ease; }
  .github-link:hover { color: #fff; }
  .github-link span { display: inline-block; margin-left: .15rem; transition: transform .25s ease; }
  .github-link:hover span { transform: translate3d(2px, -2px, 0); }
  .nav-divider { width: 1px; height: .9rem; background: rgb(255 255 255 / .12); }
  .theme-button { display: inline-flex; height: 2rem; align-items: center; gap: .48rem; border: 1px solid rgb(255 255 255 / .09); border-radius: 999px; color: rgb(255 255 255 / .72); background: rgb(255 255 255 / .055); padding: 0 .68rem; font: inherit; cursor: pointer; transition: color .25s ease, border-color .25s ease, background .25s ease, transform .25s var(--ease-premium); }
  .theme-button:hover { border-color: rgb(255 255 255 / .17); color: #fff; background: rgb(255 255 255 / .1); transform: translateY(-1px); }
  .theme-icon { position: relative; display: block; width: .76rem; height: .76rem; overflow: hidden; border: 1px solid currentColor; border-radius: 50%; transform: rotate(-28deg); transition: transform .5s var(--ease-premium), background .35s ease, box-shadow .35s ease; }
  .theme-icon::after { position: absolute; inset: -1px 50% -1px -1px; background: currentColor; content: ''; }
  :global(html[data-theme='dark']) .theme-icon { background: currentColor; box-shadow: 0 0 10px rgb(255 255 255 / .24); transform: rotate(152deg); }
  :global(html[data-theme='dark']) .theme-icon::after { background: rgb(8 8 10); }
  .theme-label { min-width: 1.45rem; font-size: .64rem; letter-spacing: .02em; }
  .menu-button { display: none; width: 2rem; height: 2rem; border: 0; color: inherit; background: transparent; padding: 0; cursor: pointer; }
  .menu-button span { display: block; width: .9rem; height: 1px; margin: 4px auto; background: currentColor; transition: transform .3s ease; }
  .menu-button.open span:first-child { transform: translateY(2.5px) rotate(45deg); }
  .menu-button.open span:last-child { transform: translateY(-2.5px) rotate(-45deg); }
  @keyframes brand-glint { 0%, 72% { left: -70%; opacity: 0; } 78% { opacity: 1; } 90%, 100% { left: 130%; opacity: 0; } }
  @media (max-width: 700px) {
    .nav-inner { display: flex; justify-content: space-between; }
    .github-link { display: none; }
    .nav-divider { display: none; }
    .nav-actions { gap: .2rem; }
    .theme-button { width: 2.25rem; height: 2.25rem; justify-content: center; padding: 0; }
    .theme-label { position: absolute; overflow: hidden; width: 1px; height: 1px; clip: rect(0 0 0 0); white-space: nowrap; }
    .menu-button { display: block; width: 2.25rem; height: 2.25rem; }
    .nav-menu { position: fixed; z-index: 0; inset: 52px 0 auto; visibility: hidden; border: 0; border-top: 1px solid rgb(255 255 255 / .07); border-radius: 0; background: rgb(8 8 10 / .96); padding: 0; box-shadow: 0 20px 48px rgb(0 0 0 / .22); opacity: 0; pointer-events: none; transform: translateY(-12px); transition: opacity .3s ease, transform .3s ease, visibility .3s; backdrop-filter: blur(24px); }
    .nav-menu.open { visibility: visible; opacity: 1; pointer-events: auto; transform: translateY(0); }
    .nav-menu ul { align-items: stretch; flex-direction: column; gap: .2rem; width: min(100% - 2rem, 32rem); margin: 0 auto; padding: .8rem 0 1rem; }
    .nav-menu a { display: block; border-radius: .8rem; padding: .8rem .9rem; color: rgb(255 255 255 / .78); font-size: .92rem; }
    .nav-menu a.active { background: rgb(255 255 255 / .09); }
  }
</style>
