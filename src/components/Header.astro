---
import { navItems, profile } from '../data/profile';
interface Props { active?: string; }
const { active } = Astro.props;
---

<header class="site-header" data-site-header>
  <nav class="nav-inner" aria-label="主导航">
    <a class="brand" href="/" aria-label={`${profile.name}，返回首页`}>{profile.name}</a>

    <div id="nav-menu" class="nav-menu">
      <ul>
        {navItems.map((item) => (
          <li><a class:list={[active === item.href && 'active']} aria-current={active === item.href ? 'page' : undefined} href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="nav-actions">
      <a class="github-link" href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <button class="menu-button" type="button" data-menu-toggle aria-label="打开导航菜单" aria-expanded="false" aria-controls="nav-menu"><span></span><span></span></button>
    </div>
  </nav>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('nav-menu');
  const closeMenu = () => {
    menu?.classList.remove('open');
    menuButton?.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', '打开导航菜单');
  };
  menuButton?.addEventListener('click', () => {
    const open = !menu?.classList.contains('open');
    menu?.classList.toggle('open', open);
    menuButton.classList.toggle('open', open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 9999;
    inset: 0 0 auto;
    height: 44px;
    border-bottom: 1px solid transparent;
    color: rgb(255 255 255 / .86);
    background: rgb(22 22 23 / .72);
    backdrop-filter: saturate(180%) blur(20px);
    transition: background .35s ease, border-color .35s ease;
  }
  .site-header.is-scrolled { border-color: rgb(255 255 255 / .08); background: rgb(22 22 23 / .86); }
  .nav-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; width: min(100% - 2rem, 64rem); height: 100%; margin: 0 auto; }
  .brand { color: #f5f5f7; font-size: .82rem; font-weight: 600; letter-spacing: -.01em; text-decoration: none; }
  .nav-menu ul { display: flex; align-items: center; gap: 2.25rem; margin: 0; padding: 0; list-style: none; }
  .nav-menu a { color: rgb(255 255 255 / .64); font-size: .73rem; font-weight: 400; letter-spacing: .01em; text-decoration: none; transition: color .25s ease; }
  .nav-menu a:hover, .nav-menu a.active { color: #fff; }
  .nav-actions { display: flex; align-items: center; justify-content: flex-end; }
  .github-link { color: rgb(255 255 255 / .72); font-size: .72rem; text-decoration: none; transition: color .25s ease; }
  .github-link:hover { color: #fff; }
  .github-link span { display: inline-block; margin-left: .15rem; transition: transform .25s ease; }
  .github-link:hover span { transform: translate3d(2px, -2px, 0); }
  .menu-button { display: none; width: 2rem; height: 2rem; border: 0; color: inherit; background: transparent; padding: 0; cursor: pointer; }
  .menu-button span { display: block; width: .9rem; height: 1px; margin: 4px auto; background: currentColor; transition: transform .3s ease; }
  .menu-button.open span:first-child { transform: translateY(2.5px) rotate(45deg); }
  .menu-button.open span:last-child { transform: translateY(-2.5px) rotate(-45deg); }
  @media (max-width: 700px) {
    .nav-inner { display: flex; justify-content: space-between; }
    .github-link { display: none; }
    .menu-button { display: block; }
    .nav-menu { position: fixed; z-index: -1; inset: 44px 0 auto; visibility: hidden; border-top: 1px solid rgb(255 255 255 / .06); background: rgb(22 22 23 / .96); opacity: 0; transform: translateY(-12px); transition: opacity .3s ease, transform .3s ease, visibility .3s; backdrop-filter: blur(24px); }
    .nav-menu.open { visibility: visible; opacity: 1; transform: translateY(0); }
    .nav-menu ul { align-items: stretch; flex-direction: column; gap: 0; width: min(100% - 3rem, 32rem); margin: 0 auto; padding: 1rem 0 1.4rem; }
    .nav-menu a { display: block; border-bottom: 1px solid rgb(255 255 255 / .08); padding: .9rem 0; color: rgb(255 255 255 / .84); font-size: 1rem; }
  }
</style>
