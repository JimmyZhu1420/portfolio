---
import { navItems, profile } from '../data/profile';
interface Props { active?: string; }
const { active } = Astro.props;
const avatarUrl = 'https://github.com/JimmyZhu1420.png?size=160';
---

<header class="site-header">
  <nav class="nav-inner" aria-label="主导航">
    <a class="brand" href="/" aria-label={`${profile.name}，返回首页`}>
      <img src={avatarUrl} alt="" width="40" height="40" />
      <span>{profile.name}</span>
    </a>

    <div id="nav-menu" class="nav-menu">
      <ul>
        {navItems.map((item) => (
          <li><a class:list={[active === item.href && 'active']} aria-current={active === item.href ? 'page' : undefined} href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="nav-actions">
      <a class="icon-link" href={profile.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">GH</a>
      <button class="theme-button" type="button" data-theme-toggle aria-label="切换深浅色主题"><span aria-hidden="true">◐</span></button>
      <button class="menu-button" type="button" data-menu-toggle aria-label="打开导航菜单" aria-expanded="false" aria-controls="nav-menu"><span aria-hidden="true">☰</span></button>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncTheme = () => {
    const dark = root.classList.contains('dark');
    themeButton?.setAttribute('aria-label', dark ? '切换到浅色主题' : '切换到深色主题');
    const icon = themeButton?.querySelector('span');
    if (icon) icon.textContent = dark ? '☀' : '◐';
  };
  themeButton?.addEventListener('click', () => {
    const dark = !root.classList.contains('dark');
    root.classList.toggle('dark', dark);
    root.dataset.theme = dark ? 'dark' : 'light';
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    syncTheme();
  });
  syncTheme();

  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('nav-menu');
  const closeMenu = () => {
    menu?.classList.remove('open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.setAttribute('aria-label', '打开导航菜单');
  };
  menuButton?.addEventListener('click', () => {
    const open = !menu?.classList.contains('open');
    menu?.classList.toggle('open', open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
</script>

<style>
  .site-header { position: fixed; z-index: 9999; inset: 0 0 auto; padding: 1rem 1.5rem; pointer-events: none; }
  .nav-inner { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; width: 100%; max-width: 60rem; margin: 0 auto; border: 1px solid color-mix(in srgb, var(--hairline) 85%, transparent); border-radius: var(--radius-2xl); background: color-mix(in srgb, var(--page-bg) 82%, transparent); padding: .625rem 1rem .625rem 1.25rem; box-shadow: 0 4px 24px rgb(93 112 82 / .08); backdrop-filter: blur(12px); pointer-events: auto; }
  .brand { display: inline-flex; min-width: 0; align-items: center; gap: .65rem; color: var(--page-text); text-decoration: none; }
  .brand img { width: 2.5rem; height: 2.5rem; border: 2px solid var(--hairline); border-radius: 50%; object-fit: cover; background: var(--surface-soft); }
  .brand span { overflow: hidden; font-size: .92rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
  .nav-menu ul { display: flex; align-items: center; margin: 0; padding: 0; list-style: none; }
  .nav-menu a { display: block; border-radius: var(--radius-lg); color: var(--muted-text); padding: .5rem .9rem; font-size: .82rem; font-weight: 520; text-decoration: none; transition: color .2s ease, background .2s ease; }
  .nav-menu a:hover { color: var(--page-text); background: var(--surface-soft); }
  .nav-menu a.active { color: var(--primary); font-weight: 650; }
  .nav-actions { display: flex; align-items: center; justify-content: flex-end; gap: .25rem; }
  .icon-link, .theme-button, .menu-button { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 0; border-radius: 50%; color: var(--muted-text); background: transparent; font: 650 .66rem/1 var(--font-mono); text-decoration: none; cursor: pointer; }
  .icon-link:hover, .theme-button:hover, .menu-button:hover { color: var(--page-text); background: var(--surface-soft); }
  .theme-button span { font: 500 1.05rem/1 var(--font-sans); }
  .menu-button { display: none; font-size: 1rem; }
  @media (max-width: 799px) {
    .site-header { padding: .75rem; }
    .nav-inner { display: flex; justify-content: space-between; padding: .5rem .55rem .5rem .75rem; }
    .brand span { display: none; }
    .menu-button { display: grid; }
    .nav-menu { position: absolute; top: calc(100% + .6rem); right: 0; left: 0; display: none; border: 1px solid var(--hairline); border-radius: var(--radius-xl); background: var(--page-bg); padding: .5rem; box-shadow: var(--shadow-md); }
    .nav-menu.open { display: block; }
    .nav-menu ul { align-items: stretch; flex-direction: column; }
    .nav-menu li { width: 100%; }
    .nav-menu a { padding: .8rem 1rem; font-size: .9rem; }
  }
</style>
