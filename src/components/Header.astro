---
import { navItems, profile } from '../data/profile';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="site-header">
  <nav class="nav-shell" aria-label="主导航">
    <a href="/" class="brand" aria-label={`${profile.name}，返回首页`}>
      <span>{profile.name}</span>
      <i aria-hidden="true"></i>
    </a>

    <div class="desktop-nav">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} class:list={[active === item.href && 'is-active']} aria-current={active === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a class="github-link" href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色主题"><span aria-hidden="true">◐</span></button>
    </div>

    <div class="mobile-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色主题"><span aria-hidden="true">◐</span></button>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="menu-toggle"
        aria-label="打开导航菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span></span><span></span>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href} class:list={[active === item.href && 'is-active']} aria-current={active === item.href ? 'page' : undefined}>
            <span>{item.label}</span><i aria-hidden="true">↗</i>
          </a>
        </li>
      ))}
      <li><a href={profile.social.github} target="_blank" rel="noopener noreferrer"><span>GitHub</span><i aria-hidden="true">↗</i></a></li>
    </ul>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeToggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const syncThemeButtons = () => {
    const dark = root.classList.contains('dark');
    themeToggles.forEach((button) => {
      button.setAttribute('aria-label', dark ? '切换到浅色主题' : '切换到深色主题');
      const icon = button.querySelector('span');
      if (icon) icon.textContent = dark ? '☼' : '◐';
    });
  };

  themeToggles.forEach((button) => {
    button.addEventListener('click', () => {
      const dark = !root.classList.contains('dark');
      root.classList.toggle('dark', dark);
      root.dataset.theme = dark ? 'dark' : 'light';
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      syncThemeButtons();
    });
  });
  syncThemeButtons();

  const menuToggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  if (menuToggle && menu) {
    const close = (restoreFocus = false) => {
      menu.hidden = true;
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', '打开导航菜单');
      menuToggle.classList.remove('is-open');
      if (restoreFocus) menuToggle.focus();
    };

    menuToggle.addEventListener('click', () => {
      const willOpen = menu.hidden;
      if (willOpen) {
        menu.hidden = false;
        menuToggle.setAttribute('aria-expanded', 'true');
        menuToggle.setAttribute('aria-label', '关闭导航菜单');
        menuToggle.classList.add('is-open');
      } else {
        close();
      }
    });

    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => close()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) close(true);
    });
    document.addEventListener('click', (event) => {
      if (!menu.hidden && !menuToggle.contains(event.target as Node) && !menu.contains(event.target as Node)) close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    background: color-mix(in srgb, var(--page-bg) 90%, transparent);
    backdrop-filter: blur(14px);
  }

  .nav-shell {
    display: flex;
    width: 100%;
    max-width: 72rem;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .brand { display: inline-flex; align-items: center; gap: .45rem; color: var(--page-text); font-size: .9rem; font-weight: 720; letter-spacing: -.025em; text-decoration: none; }
  .brand i { width: .38rem; height: .38rem; border-radius: 50%; background: var(--color-primary-500); transform: translateY(-.28rem); transition: transform 180ms ease; }
  .brand:hover i { transform: translate(.12rem, -.38rem); }
  .desktop-nav { display: flex; align-items: center; gap: 1.2rem; }
  .desktop-nav ul { display: flex; align-items: center; gap: 1.3rem; margin: 0; padding: 0; list-style: none; }
  .desktop-nav a { color: var(--muted-text); font-size: .78rem; font-weight: 580; text-decoration: none; transition: color 160ms ease; }
  .desktop-nav a:hover, .desktop-nav a.is-active { color: var(--page-text); }
  .desktop-nav a.is-active { color: var(--color-primary-600); font-weight: 680; }
  .github-link { border-left: 1px solid var(--hairline); padding-left: 1.35rem; }
  .theme-toggle, .menu-toggle { display: grid; width: 2.65rem; height: 2.65rem; place-items: center; border: 0; border-radius: 999px; color: var(--muted-text); background: transparent; cursor: pointer; }
  .theme-toggle:hover, .menu-toggle:hover { color: var(--page-text); background: var(--surface-soft); }
  .theme-toggle span { font-size: 1.05rem; }
  .mobile-actions { display: none; align-items: center; gap: 0.1rem; }
  .menu-toggle { position: relative; }
  .menu-toggle span { position: absolute; width: 1.1rem; height: 1.5px; border-radius: 999px; background: currentColor; transition: transform 180ms ease, top 180ms ease; }
  .menu-toggle span:first-child { top: 1.08rem; }
  .menu-toggle span:last-child { top: 1.58rem; }
  .menu-toggle.is-open span:first-child { top: 1.35rem; transform: rotate(45deg); }
  .menu-toggle.is-open span:last-child { top: 1.35rem; transform: rotate(-45deg); }
  .mobile-menu { border-top: 1px solid var(--hairline); background: color-mix(in srgb, var(--page-bg) 96%, transparent); }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu ul { max-width: 72rem; margin: 0 auto; padding: 0.75rem 1.25rem 1.1rem; list-style: none; }
  .mobile-menu a { display: flex; min-height: 2.9rem; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--hairline); color: var(--muted-text); font-size: 0.9rem; font-weight: 560; text-decoration: none; }
  .mobile-menu a.is-active { color: var(--color-primary-500); font-weight: 700; }
  .mobile-menu i { font-style: normal; }
  @media (max-width: 700px) {
    .desktop-nav { display: none; }
    .mobile-actions { display: flex; }
  }

  @media (prefers-reduced-motion: reduce) { .brand i { transition: none; } }
</style>
