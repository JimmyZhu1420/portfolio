---
import type { Project } from '../data/profile';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const isEvo = project.slug === 'evoagent';
---

<div
  class:list={['project-visual', `tone-${project.tone}`, compact && 'is-compact']}
  role="img"
  aria-label={`${project.name} 执行流程动态图：${project.flow.join('，')}`}
>
  <div class="visual-window">
    <div class="window-bar">
      <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <span class="window-title">{isEvo ? 'review.run' : 'evidence.run'}</span>
      <span class="live-indicator"><i></i> walkthrough</span>
    </div>

    {
      isEvo ? (
        <div class="visual-body evo-body">
          <div class="diff-card visual-card">
            <div class="card-label"><span>DEMO DIFF</span><b>example.py</b></div>
            <div class="code-line muted"><span>18</span> def verify(payload):</div>
            <div class="code-line danger"><span>19</span> + eval(payload)</div>
            <div class="code-line safe"><span>20</span> + return schema.parse(payload)</div>
            <div class="scan-line" aria-hidden="true"></div>
          </div>
          <div class="agent-grid" aria-hidden="true">
            <div class="agent-chip"><i style="--delay: 0s"></i>Security</div>
            <div class="agent-chip"><i style="--delay: .55s"></i>Reliability</div>
            <div class="agent-chip"><i style="--delay: 1.1s"></i>LLM Review</div>
          </div>
          <div class="result-card visual-card">
            <div class="result-heading"><span>Review stages</span><b>ready</b></div>
            <div class="finding-row"><i class="high"></i><span>Risk candidate detected</span><em>review</em></div>
            <div class="finding-row"><i class="medium"></i><span>Validation test suggested</span><em>verify</em></div>
            <div class="confidence"><span>evidence</span><b>linked</b></div>
          </div>
        </div>
      ) : (
        <div class="visual-body oa-body">
          <div class="case-card visual-card">
            <div class="card-label"><span>DEMO CASE</span><b>evidence mode</b></div>
            <div class="case-summary">
              <i>症状</i><span>膝关节疼痛 · 活动受限</span>
            </div>
            <div class="case-summary">
              <i>任务</i><span>检索证据并生成报告草稿</span>
            </div>
            <div class="scan-line" aria-hidden="true"></div>
          </div>
          <div class="evidence-stack">
            <div class="evidence-card visual-card">
              <div><b>NICE</b><span>2022 · official</span></div>
              <p>核心管理建议与适用边界</p>
              <div class="score"><i style="--score: 100%"></i><span>source linked</span></div>
            </div>
            <div class="evidence-card visual-card">
              <div><b>AAOS</b><span>2021 · official</span></div>
              <p>非手术治疗证据摘要</p>
              <div class="score"><i style="--score: 100%"></i><span>source linked</span></div>
            </div>
          </div>
          <div class="safety-row"><span>Claim check</span><b>complete</b><span>Rule scan</span><b>complete</b></div>
        </div>
      )
    }
  </div>

  <ol class="visual-flow" aria-hidden="true">
    {project.flow.map((step, index) => <li style={`--step: ${index}`}><i>{String(index + 1).padStart(2, '0')}</i><span>{step}</span></li>)}
  </ol>
</div>

<style>
  .project-visual {
    --accent: #6558f5;
    --accent-soft: #eeecff;
    --accent-glow: rgb(101 88 245 / 0.22);
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(15 23 42 / 0.08);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 85% 12%, var(--accent-glow), transparent 34%),
      linear-gradient(145deg, #f8fafc 0%, #f1f5f9 100%);
    padding: 1.25rem;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), 0 24px 60px rgb(15 23 42 / 0.08);
  }

  .project-visual.tone-emerald {
    --accent: #0f9f82;
    --accent-soft: #dcf8ef;
    --accent-glow: rgb(15 159 130 / 0.2);
  }

  .visual-window {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(15 23 42 / 0.1);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 18px 40px rgb(15 23 42 / 0.12);
  }

  .window-bar {
    display: flex;
    align-items: center;
    min-height: 2.35rem;
    gap: 0.7rem;
    border-bottom: 1px solid rgb(15 23 42 / 0.08);
    padding: 0 0.85rem;
    color: #64748b;
    font-family: var(--font-mono);
    font-size: 0.63rem;
  }

  .window-dots { display: flex; gap: 0.28rem; }
  .window-dots span { width: 0.38rem; height: 0.38rem; border-radius: 999px; background: #cbd5e1; }
  .window-title { flex: 1; }
  .live-indicator { display: inline-flex; align-items: center; gap: 0.3rem; color: #475569; }
  .live-indicator i { width: 0.38rem; height: 0.38rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 var(--accent-glow); animation: live-pulse 2s infinite; }

  .visual-body { position: relative; display: grid; gap: 0.65rem; min-height: 16rem; padding: 0.85rem; }
  .evo-body { grid-template-columns: 1.1fr 0.8fr; grid-template-rows: 1fr auto; }
  .oa-body { grid-template-columns: 1fr 0.9fr; grid-template-rows: 1fr auto; }
  .visual-card { position: relative; overflow: hidden; border: 1px solid #e2e8f0; border-radius: 0.75rem; background: #fff; }
  .card-label { display: flex; justify-content: space-between; gap: 0.5rem; border-bottom: 1px solid #eef2f7; padding: 0.55rem 0.7rem; color: #64748b; font: 600 0.58rem/1 var(--font-mono); letter-spacing: 0.04em; }
  .card-label b { color: var(--accent); font-weight: 600; }

  .diff-card { grid-row: span 2; min-height: 12rem; padding-bottom: 0.5rem; }
  .code-line { display: grid; grid-template-columns: 1.1rem 1fr; gap: 0.4rem; padding: 0.55rem 0.65rem 0; color: #334155; font: 500 0.61rem/1.55 var(--font-mono); }
  .code-line span { color: #94a3b8; }
  .code-line.danger { color: #b4233b; background: linear-gradient(90deg, #fff1f2, transparent); }
  .code-line.safe { color: #087a61; background: linear-gradient(90deg, #ecfdf5, transparent); }
  .code-line.muted { color: #64748b; }
  .scan-line { position: absolute; inset: 2rem 0 auto; height: 1px; background: linear-gradient(90deg, transparent, var(--accent), transparent); opacity: 0; animation: scan 4.2s ease-in-out infinite; }

  .agent-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.35rem; }
  .agent-chip { display: flex; min-width: 0; align-items: center; justify-content: center; gap: 0.3rem; border: 1px solid #e2e8f0; border-radius: 0.55rem; padding: 0.48rem 0.25rem; color: #475569; background: #f8fafc; font: 600 0.52rem/1 var(--font-mono); }
  .agent-chip i { width: 0.35rem; height: 0.35rem; flex: none; border-radius: 50%; background: var(--accent); animation: agent-pulse 2.1s ease-in-out infinite; animation-delay: var(--delay); }

  .result-card { padding: 0.65rem; }
  .result-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.45rem; color: #475569; font: 600 0.58rem/1 var(--font-mono); }
  .result-heading b { color: var(--accent); font-size: 0.82rem; }
  .finding-row { display: grid; grid-template-columns: 0.38rem 1fr auto; align-items: center; gap: 0.35rem; padding: 0.26rem 0; color: #334155; font-size: 0.56rem; }
  .finding-row i { width: 0.34rem; height: 0.34rem; border-radius: 50%; }
  .finding-row i.high { background: #e5484d; }
  .finding-row i.medium { background: #f5a524; }
  .finding-row em { color: #94a3b8; font-family: var(--font-mono); font-style: normal; }
  .confidence { display: flex; justify-content: space-between; margin-top: 0.35rem; border-top: 1px dashed #e2e8f0; padding-top: 0.4rem; color: #64748b; font: 500 0.54rem/1 var(--font-mono); }
  .confidence b { color: #087a61; }

  .case-card { min-height: 10.5rem; }
  .case-summary { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.5rem; padding: 0.7rem 0.7rem 0; color: #334155; font-size: 0.62rem; line-height: 1.45; }
  .case-summary i { height: fit-content; border-radius: 999px; background: var(--accent-soft); padding: 0.15rem 0.35rem; color: var(--accent); font: 600 0.52rem/1.2 var(--font-mono); font-style: normal; text-align: center; }
  .evidence-stack { display: grid; gap: 0.5rem; }
  .evidence-card { padding: 0.6rem; }
  .evidence-card > div:first-child { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
  .evidence-card b { color: #0f172a; font: 700 0.62rem/1 var(--font-mono); }
  .evidence-card span { color: #64748b; font: 500 0.5rem/1 var(--font-mono); }
  .evidence-card p { margin: 0.45rem 0; color: #475569; font-size: 0.57rem; }
  .score { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.4rem; }
  .score::before { content: ''; grid-column: 1; grid-row: 1; height: 0.25rem; border-radius: 999px; background: #e2e8f0; }
  .score i { grid-column: 1; grid-row: 1; width: var(--score); height: 0.25rem; border-radius: 999px; background: var(--accent); transform-origin: left; animation: score-grow 3s ease-in-out infinite; }
  .safety-row { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr auto 1fr auto; align-items: center; gap: 0.45rem; border: 1px solid #d7eee8; border-radius: 0.65rem; background: #f0fdf9; padding: 0.55rem 0.65rem; color: #47645e; font: 600 0.55rem/1 var(--font-mono); }
  .safety-row b { color: #087a61; font-weight: 700; }

  .visual-flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; margin: 1rem 0 0; padding: 0; list-style: none; }
  .visual-flow li { position: relative; display: flex; min-width: 0; flex-direction: column; align-items: center; gap: 0.3rem; color: #64748b; font: 500 0.52rem/1.25 var(--font-mono); text-align: center; }
  .visual-flow li:not(:last-child)::after { content: ''; position: absolute; top: 0.48rem; left: calc(50% + 0.75rem); width: calc(100% - 1.5rem); height: 1px; background: linear-gradient(90deg, var(--accent), #cbd5e1); transform-origin: left; animation: flow-line 3.5s ease-in-out infinite; animation-delay: calc(var(--step) * 0.22s); }
  .visual-flow i { position: relative; z-index: 1; display: grid; width: 1.05rem; height: 1.05rem; place-items: center; border: 1px solid color-mix(in srgb, var(--accent) 45%, white); border-radius: 50%; background: #fff; color: var(--accent); font-size: 0.45rem; font-style: normal; }

  .is-compact { padding: 1rem; }
  .is-compact .visual-body { min-height: 14rem; }
  .is-compact .visual-flow { margin-top: 0.8rem; }

  :global(.dark) .project-visual { border-color: rgb(148 163 184 / 0.16); background: radial-gradient(circle at 85% 12%, var(--accent-glow), transparent 34%), linear-gradient(145deg, #111827, #0b1220); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 24px 60px rgb(0 0 0 / 0.25); }
  :global(.dark) .visual-window, :global(.dark) .visual-card { border-color: #263244; background: rgb(15 23 42 / 0.94); }
  :global(.dark) .window-bar, :global(.dark) .card-label { border-color: #263244; color: #94a3b8; }
  :global(.dark) .window-dots span { background: #475569; }
  :global(.dark) .code-line, :global(.dark) .finding-row, :global(.dark) .case-summary, :global(.dark) .evidence-card p { color: #cbd5e1; }
  :global(.dark) .code-line.danger { color: #fda4af; background: linear-gradient(90deg, rgb(136 19 55 / .2), transparent); }
  :global(.dark) .code-line.safe { color: #6ee7c7; background: linear-gradient(90deg, rgb(6 95 70 / .2), transparent); }
  :global(.dark) .agent-chip { border-color: #263244; color: #cbd5e1; background: #111827; }
  :global(.dark) .evidence-card b { color: #f8fafc; }
  :global(.dark) .safety-row { border-color: #175e51; background: rgb(6 78 59 / .2); color: #a7f3d0; }
  :global(.dark) .visual-flow i { background: #0f172a; }

  @keyframes live-pulse { 50% { box-shadow: 0 0 0 0.35rem transparent; } }
  @keyframes agent-pulse { 0%, 100% { opacity: .45; transform: scale(.8); } 45% { opacity: 1; transform: scale(1.15); } }
  @keyframes scan { 0%, 12% { top: 2.3rem; opacity: 0; } 25% { opacity: .7; } 72% { top: calc(100% - .7rem); opacity: .5; } 85%, 100% { opacity: 0; } }
  @keyframes score-grow { 0%, 15% { transform: scaleX(.18); opacity: .45; } 45%, 85% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(.18); opacity: .45; } }
  @keyframes flow-line { 0%, 20% { transform: scaleX(0); opacity: .2; } 55%, 85% { transform: scaleX(1); opacity: 1; } 100% { opacity: .25; } }

  @media (max-width: 520px) {
    .project-visual { padding: 0.75rem; border-radius: 1.1rem; }
    .visual-body { min-height: 14rem; padding: 0.65rem; }
    .evo-body, .oa-body { grid-template-columns: 1fr; }
    .diff-card { grid-row: auto; min-height: 8rem; }
    .agent-grid { display: none; }
    .case-card { min-height: 8.5rem; }
    .evidence-stack { grid-template-columns: 1fr 1fr; }
    .safety-row { grid-column: auto; grid-template-columns: 1fr auto; }
    .visual-flow span { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-visual *, .project-visual *::before, .project-visual *::after { animation: none !important; }
    .score i { transform: scaleX(1); }
    .scan-line { display: none; }
  }
</style>
