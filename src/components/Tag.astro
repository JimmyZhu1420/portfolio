---
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<span class="tag">{label}</span>

<style>
  .tag { display: inline-flex; align-items: center; border: 1px solid var(--hairline); border-radius: 999px; color: var(--muted-text); background: var(--surface); padding: .36rem .58rem; font: 570 .62rem/1 var(--font-mono); }
</style>
