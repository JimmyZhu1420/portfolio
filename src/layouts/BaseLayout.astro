---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
  active?: string;
  article?: boolean;
  socialImage?: string | null;
  socialImageAlt?: string;
}

const {
  title,
  description = profile.tagline,
  active,
  article = false,
  socialImage = '/og.png',
  socialImageAlt = '朱佳明 · AI Agent 工程：项目、证据与技术笔记',
} = Astro.props;
const fullTitle = title === '首页' ? `${profile.name} · AI Agent 工程` : `${title} · ${profile.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: new URL('/', Astro.site).toString(),
  email: `mailto:${profile.email}`,
  sameAs: [profile.social.github],
  alumniOf: profile.education.map((item) => ({ '@type': 'EducationalOrganization', name: item.split('·')[0].trim() })),
  knowsAbout: profile.researchInterests,
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f6f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171613" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}的文章`} href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={new URL(socialImage, Astro.site)} />}
    {socialImage && <meta property="og:image:width" content="1733" />}
    {socialImage && <meta property="og:image:height" content="907" />}
    {socialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={new URL(socialImage, Astro.site)} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const dark = stored ? stored === 'dark' : systemDark.matches;
        root.classList.toggle('dark', dark);
        root.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header active={active} />
    <main id="main-content" class="mx-auto w-full max-w-6xl px-5 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
