---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动。" socialImage={null}>
  <section class="not-found">
    <div class="not-found-orbit" aria-hidden="true"><i></i></div>
    <div class="shell">
      <p data-reveal>404 · PAGE NOT FOUND</p>
      <h1 data-reveal>这里暂时<br /><span>什么也没有。</span></h1>
      <p class="description" data-reveal>可能是链接改变了，也可能是这个想法还没有被实现。</p>
      <a href="/" data-reveal>回到首页 <span aria-hidden="true">›</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { position: relative; display: grid; min-height: calc(100svh - 44px); place-items: center; overflow: hidden; color: #f5f5f7; background: #000; padding: 5rem 0; isolation: isolate; }
  .not-found::before { position: absolute; z-index: -1; right: -20rem; bottom: -24rem; width: 55rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(28 115 255 / .22), rgb(134 71 255 / .08) 44%, transparent 70%); content: ''; filter: blur(35px); }
  .not-found-orbit { position: absolute; z-index: -1; top: 50%; right: -8rem; width: min(48vw, 34rem); aspect-ratio: 1; border: 1px solid rgb(83 166 255 / .16); border-radius: 50%; transform: translateY(-50%) rotateX(68deg); animation: orbit 20s linear infinite; }
  .not-found-orbit::before { position: absolute; inset: 22%; border: 1px solid rgb(158 103 255 / .13); border-radius: 50%; content: ''; }
  .not-found-orbit i { position: absolute; top: 12%; left: 28%; width: .6rem; height: .6rem; border: 1px solid #fff; border-radius: 50%; background: #0071e3; box-shadow: 0 0 18px #0071e3; }
  .not-found .shell > p:first-of-type { margin: 0 0 1.4rem; color: #2997ff; font-size: .72rem; font-weight: 650; letter-spacing: .13em; }
  h1 { margin: 0; font-size: clamp(3rem, 5vw, 4rem); font-weight: 650; letter-spacing: -.06em; line-height: 1; }
  h1 span { color: #86868b; }
  .description { max-width: 32rem; margin: 2rem 0 0; color: #a1a1a6; font-size: 1.08rem; line-height: 1.65; }
  .not-found a { display: inline-block; margin-top: 2rem; color: #2997ff; font-size: 1rem; text-decoration: none; }
  .not-found a span { display: inline-block; margin-left: .2rem; font-size: 1.3rem; transition: transform .3s var(--ease-premium); }
  .not-found a:hover span { transform: translateX(4px); }
  @keyframes orbit { to { rotate: 360deg; } }
</style>
