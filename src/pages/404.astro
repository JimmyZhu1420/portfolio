---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动。" socialImage={null}>
  <section class="not-found site-wrapper">
    <p>404 · PAGE NOT FOUND</p>
    <h1>这里暂时什么也没有。</h1>
    <span>可能是链接改了，也可能是我还没写到这里。</span>
    <a href="/">回到首页 <i aria-hidden="true">→</i></a>
  </section>
</BaseLayout>

<style>
  .not-found { max-width: 64rem; padding-block: clamp(6rem, 16vw, 12rem) 3rem; }
  .not-found > p { color: var(--primary); font-size: .7rem; font-weight: 650; letter-spacing: .07em; }
  h1 { margin-top: .8rem; font-family: var(--font-brand); font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 680; letter-spacing: -.03em; line-height: 1.2; }
  .not-found > span { display: block; margin-top: 1rem; color: var(--muted-text); font-size: .85rem; line-height: 1.8; }
  .not-found a { display: inline-flex; gap: .4rem; margin-top: 1.5rem; color: var(--page-text); font-size: .76rem; font-weight: 650; text-underline-offset: .22rem; }
  .not-found i { color: var(--primary); font-style: normal; }
</style>
