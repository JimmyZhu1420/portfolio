---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动。" socialImage={null}>
  <section class="not-found">
    <p>404 · PAGE NOT FOUND</p>
    <h1>这里暂时什么也没有。</h1>
    <span>可能是链接改了，也可能是我还没写到这里。</span>
    <a href="/">回到首页 <i aria-hidden="true">→</i></a>
  </section>
</BaseLayout>

<style>
  .not-found { max-width: 42rem; padding: clamp(6rem, 16vw, 12rem) 0 3rem; }
  .not-found > p { color: var(--color-primary-600); font: 650 .65rem/1 var(--font-mono); letter-spacing: .07em; }
  h1 { margin-top: .8rem; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 710; letter-spacing: -.05em; line-height: 1.15; }
  .not-found > span { display: block; margin-top: 1rem; color: var(--muted-text); font-size: .85rem; line-height: 1.8; }
  .not-found a { display: inline-flex; gap: .4rem; margin-top: 1.5rem; color: var(--page-text); font-size: .76rem; font-weight: 650; text-underline-offset: .22rem; }
  .not-found i { color: var(--color-primary-600); font-style: normal; }
</style>
