---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const stackGroups = [
  { title: 'Agent Systems', items: ['LangGraph', 'Agent Runtime', 'Tool Registry', 'Memory', 'Checkpoint'] },
  { title: 'Backend & Data', items: ['Python', 'FastAPI', 'PostgreSQL', 'Redis Streams', 'Qdrant'] },
  { title: 'Evaluation & Ops', items: ['Hybrid RAG', 'Docker', 'OpenTelemetry', 'CI', 'Replay'] },
];
---

<BaseLayout title="关于" description="关于朱佳明、AI Agent 工程实践和这个博客。" active="/about">
  <div class="about-page">
    <header class="about-hero">
      <div class="hero-light" aria-hidden="true"></div>
      <div class="shell">
        <p data-reveal>ABOUT · ZHU JIAMING</p>
        <h1 data-reveal>关于我</h1>
        <div class="hero-meta" data-reveal>
          <p>{profile.role}</p>
          <span>{profile.location}</span>
        </div>
      </div>
    </header>

    <div>
      <section class="intro-section shell">
        <div class="intro-label" data-reveal><span>01</span><p>WHO I AM</p></div>
        <div class="intro-copy">
          <p class="intro-lead" data-reveal>我是朱佳明，一名关注 AI Agent 系统工程的计算机硕士研究生。</p>
          <div class="intro-columns" data-stagger>
            {profile.about.map((paragraph) => <p data-reveal>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section class="focus-section">
        <div class="shell">
          <header class="section-heading">
            <div class="intro-label" data-reveal><span>02</span><p>WHAT I FOCUS ON</p></div>
            <h2 data-reveal>从模型能力，<br />到系统可信度。</h2>
          </header>
          <div class="focus-grid" data-stagger>
            {profile.capabilities.map((capability) => (
              <a href={capability.href} data-reveal>
                <span>{capability.index}</span>
                <h3>{capability.title}</h3>
                <p>{capability.description}</p>
                <div>{capability.technologies.slice(0, 3).map((item) => <i>{item}</i>)}</div>
                <b>{capability.evidence} <em aria-hidden="true">↗</em></b>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="education-section shell">
        <div class="intro-label" data-reveal><span>03</span><p>EDUCATION</p></div>
        <div class="education-content">
          <h2 data-reveal>学习经历。</h2>
          <ol data-stagger>
            {profile.education.map((item, index) => {
              const parts = item.split('·').map((part) => part.trim());
              return (
                <li data-reveal>
                  <span>0{index + 1}</span>
                  <div><h3>{parts[0]}</h3><p>{parts.slice(1, -1).join(' · ')}</p></div>
                </li>
              );
            })}
          </ol>
        </div>
      </section>

      <section class="stack-section">
        <div class="shell">
          <div class="intro-label" data-reveal><span>04</span><p>TOOLKIT</p></div>
          <div class="stack-content">
            <h2 data-reveal>用合适的工具，<br />解决真实的问题。</h2>
            <div class="stack-grid" data-stagger>
              {stackGroups.map((group) => (
                <section data-reveal>
                  <h3>{group.title}</h3>
                  <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
                </section>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="site-section shell">
        <div class="intro-label" data-reveal><span>05</span><p>THIS SITE</p></div>
        <div class="site-copy">
          <h2 data-reveal>一个长期生长的<br />个人工作台。</h2>
          <p data-reveal>这里用来展示项目、发布技术文章，也记录我学习 AI Agent 和做工程实践的过程。网站由 Astro 与 Content Collections 构建，内容和代码会持续更新。</p>
          <div class="site-links" data-reveal>
            <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro ↗</a>
            <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
        </div>
      </section>

      <section class="contact-section">
        <div class="contact-orbit" aria-hidden="true"><i></i><i></i></div>
        <div class="shell contact-inner" data-reveal>
          <p>GET IN TOUCH</p>
          <h2>联系方式</h2>
          <div class="contact-actions">
            <a class="mail-action" href={`mailto:${profile.email}`}>发送邮件</a>
            <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          </div>
          <div class="contact-meta"><span>{profile.email}</span><span>WeChat · {profile.social.wechat}</span></div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page { background: #fff; }
  .about-hero { position: relative; overflow: hidden; color: #f5f5f7; background: #000; padding: clamp(6rem, 10vw, 8rem) 0 4rem; isolation: isolate; }
  .hero-light { position: absolute; z-index: -1; top: 5%; right: -20%; width: 48rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(32 123 255 / .25), rgb(132 74 255 / .1) 43%, transparent 70%); filter: blur(40px); }
  .about-hero .shell > p { margin: 0 0 1.5rem; color: #2997ff; font-size: .75rem; font-weight: 650; letter-spacing: .13em; }
  h1 { margin: 0; font-size: clamp(3rem, 5vw, 4rem); font-weight: 650; letter-spacing: -.06em; line-height: 1; }
  .hero-meta { display: flex; align-items: center; justify-content: space-between; gap: 3rem; border-top: 1px solid rgb(255 255 255 / .15); margin-top: clamp(4rem, 8vw, 7rem); padding-top: 1.6rem; color: #a1a1a6; }
  .hero-meta p { margin: 0; font-size: clamp(1rem, 1.6vw, 1.25rem); }
  .hero-meta span { color: #6e6e73; font: .68rem/1 var(--font-mono); letter-spacing: .08em; }
  .intro-section, .education-section, .site-section { display: grid; grid-template-columns: 12rem 1fr; gap: 3rem; padding-block: clamp(7rem, 12vw, 11rem); }
  .intro-label { display: flex; align-items: flex-start; gap: .65rem; padding-top: .35rem; }
  .intro-label span { color: #86868b; font: .62rem/1 var(--font-mono); }
  .intro-label p { margin: 0; color: #0066cc; font-size: .67rem; font-weight: 650; letter-spacing: .11em; }
  .intro-lead { max-width: 52rem; margin: 0; font-size: clamp(2rem, 3.7vw, 3rem); font-weight: 630; letter-spacing: -.05em; line-height: 1.12; }
  .intro-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; border-top: 1px solid #d2d2d7; margin-top: 3.5rem; padding-top: 1.8rem; }
  .intro-columns p { margin: 0; color: #515154; font-size: 1.02rem; line-height: 1.75; }
  .current-note { margin: 2.5rem 0 0; color: #6e6e73; font-size: .9rem; }
  .current-note strong { color: #0066cc; font-weight: 600; }
  .focus-section { background: #f5f5f7; padding: clamp(7rem, 12vw, 11rem) 0; }
  .section-heading { display: grid; grid-template-columns: 12rem 1fr; gap: 3rem; }
  .section-heading h2, .education-content > h2, .stack-content > h2, .site-copy > h2, .contact-inner h2 { margin: 0; font-size: clamp(2.25rem, 4vw, 3.25rem); font-weight: 640; letter-spacing: -.05em; line-height: 1.05; }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-top: 4rem; }
  .focus-grid > a { display: flex; min-height: 30rem; flex-direction: column; border-radius: 2rem; color: #1d1d1f; background: #fff; padding: 2rem; text-decoration: none; transition: transform .5s var(--ease-premium), box-shadow .5s ease; }
  .focus-grid > a:hover { box-shadow: 0 24px 60px rgb(0 0 0 / .1); transform: translateY(-7px); }
  .focus-grid > a > span { color: #0066cc; font: 600 .68rem/1 var(--font-mono); }
  .focus-grid h3 { margin: 4.2rem 0 1rem; font-size: 1.75rem; font-weight: 630; letter-spacing: -.04em; }
  .focus-grid > a > p { margin: 0; color: #6e6e73; font-size: .92rem; line-height: 1.7; }
  .focus-grid > a > div { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1.5rem; }
  .focus-grid i { border: 1px solid #e5e5e7; border-radius: 999px; color: #6e6e73; padding: .4rem .55rem; font-size: .58rem; font-style: normal; }
  .focus-grid b { margin-top: auto; color: #0066cc; font-size: .75rem; font-weight: 550; }
  .focus-grid em { display: inline-block; margin-left: .2rem; font-style: normal; transition: transform .3s var(--ease-premium); }
  .focus-grid a:hover em { transform: translate3d(3px, -3px, 0); }
  .education-content ol { margin: 3.5rem 0 0; padding: 0; list-style: none; }
  .education-content li { display: grid; grid-template-columns: 4rem 1fr; gap: 1.5rem; border-top: 1px solid #d2d2d7; padding: 2rem 0; }
  .education-content li > span { color: #86868b; font: .62rem/1.5 var(--font-mono); }
  .education-content h3 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 630; letter-spacing: -.04em; }
  .education-content li p { margin: .55rem 0 0; color: #6e6e73; font-size: .9rem; line-height: 1.55; }
  .stack-section { color: #f5f5f7; background: #000; padding: clamp(7rem, 12vw, 11rem) 0; }
  .stack-section .shell { display: grid; grid-template-columns: 12rem 1fr; gap: 3rem; }
  .stack-section .intro-label p { color: #2997ff; }
  .stack-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 4rem; background: rgb(255 255 255 / .13); }
  .stack-grid section { background: #000; padding: 1.5rem 1.5rem 1.5rem 0; }
  .stack-grid section + section { padding-left: 1.5rem; }
  .stack-grid h3 { margin: 0 0 2rem; color: #a1a1a6; font-size: .72rem; font-weight: 550; letter-spacing: .05em; }
  .stack-grid ul { display: grid; gap: .9rem; margin: 0; padding: 0; list-style: none; }
  .stack-grid li { font-size: 1.03rem; font-weight: 520; }
  .site-copy > p { max-width: 42rem; margin: 2.3rem 0 0; color: #515154; font-size: 1.08rem; line-height: 1.7; }
  .site-links { display: flex; gap: 1.7rem; margin-top: 2rem; }
  .site-links a { color: #0066cc; font-size: .9rem; text-decoration: none; }
  .contact-section { position: relative; overflow: hidden; color: #f5f5f7; background: #000; padding: clamp(7rem, 12vw, 11rem) 0 4rem; text-align: center; isolation: isolate; }
  .contact-section::before { position: absolute; z-index: -1; right: 50%; bottom: -30rem; width: 65rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(28 115 255 / .2), transparent 62%); content: ''; filter: blur(28px); transform: translateX(50%); }
  .contact-orbit { position: absolute; z-index: -1; top: 9%; left: 50%; width: min(80vw, 46rem); aspect-ratio: 1; border: 1px solid rgb(73 159 255 / .14); border-radius: 50%; transform: translateX(-50%) rotateX(72deg); animation: orbit 20s linear infinite; }
  .contact-orbit::before { position: absolute; inset: 18%; border: 1px solid rgb(150 96 255 / .13); border-radius: 50%; content: ''; }
  .contact-orbit i { position: absolute; width: .55rem; height: .55rem; border: 1px solid #fff; border-radius: 50%; background: #0071e3; box-shadow: 0 0 16px #0071e3; }
  .contact-orbit i:first-child { top: 9%; left: 28%; }
  .contact-orbit i:last-child { right: 7%; bottom: 24%; background: #9a6aff; box-shadow: 0 0 16px #9a6aff; }
  .contact-inner > p { margin: 0 0 1.5rem; color: #2997ff; font-size: .72rem; font-weight: 650; letter-spacing: .12em; }
  .contact-actions { display: flex; align-items: center; justify-content: center; gap: 1.7rem; margin-top: 2.5rem; }
  .contact-actions a { color: #2997ff; font-size: .9rem; text-decoration: none; }
  .contact-actions .mail-action { border-radius: 999px; color: #fff; background: #0071e3; padding: .78rem 1.25rem; transition: background .25s ease, transform .25s var(--ease-premium); }
  .contact-actions .mail-action:hover { background: #0077ed; transform: scale(1.03); }
  .contact-meta { display: flex; justify-content: space-between; border-top: 1px solid rgb(255 255 255 / .12); margin-top: clamp(5rem, 10vw, 8rem); padding-top: 1.4rem; color: #6e6e73; font-size: .68rem; }
  @keyframes orbit { to { rotate: 360deg; } }
  @media (max-width: 860px) {
    .intro-section, .section-heading, .education-section, .stack-section .shell, .site-section { grid-template-columns: 1fr; gap: 2rem; }
    .focus-grid { grid-template-columns: 1fr; }
    .focus-grid > a { min-height: 23rem; }
  }
  @media (max-width: 650px) {
    .about-hero { padding-top: 6rem; }
    h1 { font-size: clamp(2.8rem, 14vw, 3.6rem); }
    .hero-meta { align-items: flex-start; flex-direction: column; }
    .intro-columns, .stack-grid { grid-template-columns: 1fr; }
    .stack-grid { gap: 0; background: transparent; }
    .stack-grid section, .stack-grid section + section { border-top: 1px solid rgb(255 255 255 / .13); padding: 1.5rem 0; }
    .contact-meta { align-items: center; flex-direction: column; gap: .8rem; }
  }
</style>
