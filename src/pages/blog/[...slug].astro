---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: sorted[index - 1] ?? null, older: sorted[index + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const articleText = (post.body ?? '').replace(/[`#>*_\[\]()!-]/g, '').replace(/\s+/g, '');
const charCount = articleText.length;
const readingMinutes = Math.max(1, Math.ceil(charCount / 400));
---

<BaseLayout title={post.data.title} description={post.data.description} active="/blog" article socialImage={null}>
  <div class="site-wrapper article-shell">
    <article>
      <a class="back-link" href="/blog">← 返回文章列表</a>
      <header>
        <h1>{post.data.title}</h1>
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>发布于：{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
          <span>·</span><span>{charCount} 字</span><span>·</span><span>{readingMinutes} 分钟</span>
        </div>
        <div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
      </header>
      <div class="article-prose"><Content /></div>
      <nav class="post-nav" aria-label="相邻文章">
        {older ? <a href={`/blog/${older.id}`}><span>较早一篇</span><strong>← {older.data.title}</strong></a> : <span />}
        {newer ? <a class="newer" href={`/blog/${newer.id}`}><span>较新一篇</span><strong>{newer.data.title} →</strong></a> : <span />}
      </nav>
    </article>
  </div>
</BaseLayout>

<style>
  .article-shell { padding-block: 2.5rem 7rem; }
  article { max-width: 52rem; margin: 0 auto; }
  .back-link { color: var(--muted-text); font-size: .78rem; text-decoration: none; }
  .back-link:hover { color: var(--primary); }
  header { padding: 2.5rem 0 3rem; text-align: center; }
  h1 { margin: 0 auto; font-family: var(--font-brand); font-size: clamp(2rem, 5vw, 3rem); font-weight: 680; letter-spacing: -.02em; line-height: 1.3; }
  .meta { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; margin-top: 1.1rem; color: var(--muted-text); font-size: .78rem; }
  .tags { display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; margin-top: 1rem; }
  .tags span { border-radius: 999px; color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); padding: .32rem .6rem; font-size: .7rem; }
  .article-prose { color: var(--page-text); font-size: 1rem; line-height: 1.9; }
  .article-prose :global(h2) { margin: 2.7rem 0 1rem; font-family: var(--font-brand); font-size: 1.8rem; font-weight: 650; line-height: 1.35; }
  .article-prose :global(h3) { margin: 2.2rem 0 .8rem; font-family: var(--font-brand); font-size: 1.35rem; font-weight: 650; }
  .article-prose :global(p) { margin: 1rem 0; }
  .article-prose :global(ul), .article-prose :global(ol) { display: grid; gap: .4rem; margin: 1rem 0; padding-left: 1.5rem; }
  .article-prose :global(li::marker) { color: var(--primary); }
  .article-prose :global(a) { color: var(--primary); text-underline-offset: .18rem; }
  .article-prose :global(blockquote) { border-left: 4px solid var(--primary); margin: 1.5rem 0; border-radius: 0 var(--radius-md) var(--radius-md) 0; color: var(--muted-text); background: var(--surface-soft); padding: .9rem 1.2rem; }
  .article-prose :global(pre) { overflow-x: auto; border: 1px solid var(--hairline); border-radius: var(--radius-md); background: var(--surface-soft) !important; padding: 1rem; }
  .article-prose :global(code) { font-family: var(--font-mono); font-size: .88em; }
  .article-prose :global(:not(pre) > code) { border-radius: .35rem; background: var(--surface-soft); padding: .15rem .32rem; }
  .article-prose :global(img) { border-radius: var(--radius-lg); }
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-top: 1px solid var(--hairline); margin-top: 4rem; padding-top: 1.5rem; }
  .post-nav a { display: flex; min-width: 0; flex-direction: column; gap: .35rem; color: inherit; text-decoration: none; }
  .post-nav a.newer { text-align: right; }
  .post-nav span { color: var(--muted-text); font-size: .7rem; }
  .post-nav strong { overflow: hidden; font-size: .82rem; text-overflow: ellipsis; white-space: nowrap; }
  .post-nav a:hover strong { color: var(--primary); }
  @media (max-width: 600px) { .article-shell { padding-top: 1.5rem; } header { padding-top: 2rem; } .article-prose { font-size: .95rem; } }
</style>
