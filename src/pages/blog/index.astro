---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="文章" description="记录 AI Agent 工程中的设计选择、验证证据与失败边界。" active="/blog">
  <div class="blog-page">
    <header class="blog-hero">
      <div class="hero-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="shell">
        <p data-reveal>NOTES FROM THE BUILD</p>
        <h1 data-reveal>文章</h1>
        <div class="hero-meta" data-reveal>
          <p>记录我构建 AI Agent 系统时的设计取舍、验证方法，以及那些比漂亮 Demo 更重要的能力边界。</p>
          <span>{posts.length.toString().padStart(2, '0')} 篇公开文章</span>
        </div>
      </div>
    </header>

    <div class="posts-section shell">
      <div class="list-header" data-reveal><span>INDEX</span><span>2026 — NOW</span></div>
      <ol class="posts-list" data-stagger>
        {posts.map((post, index) => (
          <li data-reveal>
            <a href={`/blog/${post.id}`}>
              <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
              <div class="post-copy">
                <div class="post-meta"><span>AI AGENT ENGINEERING</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time></div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <span class="post-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

  </div>
</BaseLayout>

<style>
  .blog-page { background: #fff; }
  .blog-hero { position: relative; overflow: hidden; color: #f5f5f7; background: #000; padding: clamp(6rem, 10vw, 8rem) 0 4rem; isolation: isolate; }
  .blog-hero::before { position: absolute; z-index: -1; top: 15%; right: -15%; width: 38rem; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(72 135 255 / .2), rgb(140 65 255 / .09) 45%, transparent 70%); content: ''; filter: blur(32px); }
  .hero-orbit { position: absolute; top: 14%; right: max(-3rem, calc((100vw - 72rem) / 2)); width: min(38vw, 30rem); aspect-ratio: 1; border: 1px solid rgb(255 255 255 / .08); border-radius: 50%; opacity: .7; animation: orbit 24s linear infinite; }
  .hero-orbit::before, .hero-orbit::after { position: absolute; border: 1px solid rgb(93 171 255 / .14); border-radius: 50%; content: ''; }
  .hero-orbit::before { inset: 17%; }
  .hero-orbit::after { inset: 34%; }
  .hero-orbit i { position: absolute; width: .5rem; height: .5rem; border: 1px solid #fff; border-radius: 50%; background: #0071e3; box-shadow: 0 0 16px #0071e3; }
  .hero-orbit i:nth-child(1) { top: 12%; left: 22%; }
  .hero-orbit i:nth-child(2) { top: 48%; right: -1%; background: #9b6dff; box-shadow: 0 0 16px #9b6dff; }
  .hero-orbit i:nth-child(3) { bottom: 8%; left: 31%; width: .35rem; height: .35rem; }
  .blog-hero .shell > p, .blog-note p { margin: 0 0 1.5rem; color: #2997ff; font-size: .75rem; font-weight: 650; letter-spacing: .13em; }
  h1 { margin: 0; font-size: clamp(3rem, 5vw, 4rem); font-weight: 650; letter-spacing: -.06em; line-height: 1; }
  .hero-meta { display: flex; align-items: flex-end; justify-content: space-between; gap: 3rem; border-top: 1px solid rgb(255 255 255 / .15); margin-top: clamp(4rem, 8vw, 7rem); padding-top: 1.7rem; }
  .hero-meta p { max-width: 39rem; margin: 0; color: #a1a1a6; font-size: clamp(1.05rem, 1.7vw, 1.3rem); line-height: 1.6; }
  .hero-meta span { flex: none; color: #6e6e73; font: .67rem/1 var(--font-mono); letter-spacing: .08em; }
  .posts-section { padding-block: clamp(5rem, 9vw, 8rem); }
  .list-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d2d2d7; padding-bottom: 1rem; color: #86868b; font: .62rem/1 var(--font-mono); letter-spacing: .1em; }
  .posts-list { margin: 0; padding: 0; list-style: none; }
  .posts-list li { border-bottom: 1px solid #d2d2d7; }
  .posts-list a { display: grid; grid-template-columns: 4rem 1fr auto; gap: 2rem; color: #1d1d1f; padding: 3rem 0; text-decoration: none; transition: padding .45s var(--ease-premium); }
  .posts-list a:hover { padding-inline: 1rem; }
  .post-index { color: #86868b; font: .65rem/1.3 var(--font-mono); }
  .post-meta { display: flex; align-items: center; gap: 1rem; color: #86868b; font-size: .68rem; }
  .post-meta span { color: #0066cc; font-weight: 650; letter-spacing: .08em; }
  .post-copy h2 { max-width: 50rem; margin: .9rem 0 .75rem; font-size: clamp(1.8rem, 3.2vw, 2.8rem); font-weight: 640; letter-spacing: -.048em; line-height: 1.08; transition: color .25s ease; }
  .posts-list a:hover h2 { color: #0066cc; }
  .post-copy > p { max-width: 42rem; margin: 0; color: #6e6e73; font-size: .96rem; line-height: 1.65; }
  .post-arrow { align-self: center; color: #0066cc; font-size: 1.3rem; transition: transform .35s var(--ease-premium); }
  .posts-list a:hover .post-arrow { transform: translate3d(4px, -4px, 0); }
  .blog-note { color: #f5f5f7; background: #000; padding: clamp(7rem, 12vw, 11rem) 0; text-align: center; }
  .blog-note h2 { margin: 0; font-size: clamp(3rem, 6.7vw, 6rem); font-weight: 650; letter-spacing: -.064em; line-height: .98; }
  .blog-note a { display: inline-block; margin-top: 2.3rem; color: #2997ff; font-size: 1rem; text-decoration: none; }
  .blog-note a span { margin-left: .2rem; font-size: 1.3rem; }
  @keyframes orbit { to { rotate: 360deg; } }
  @media (max-width: 650px) {
    .blog-hero { padding-top: 6rem; }
    h1 { font-size: clamp(2.8rem, 14vw, 3.6rem); }
    .hero-orbit { top: 32%; right: -32%; width: 70vw; }
    .hero-meta { align-items: flex-start; flex-direction: column; }
    .posts-list a { grid-template-columns: 2rem 1fr; gap: .75rem; padding: 2.2rem 0; }
    .post-arrow { display: none; }
    .post-meta { align-items: flex-start; flex-direction: column; gap: .35rem; }
    .post-copy h2 { font-size: 2.2rem; }
  }
</style>
