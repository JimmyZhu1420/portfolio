---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="文章" description="记录 AI Agent 项目里的实现、证据与没有成功的捷径。" active="/blog">
  <header class="page-head">
    <p class="eyebrow">NOTES FROM BUILDING</p>
    <h1>写下做项目时<br />真正遇到的<em>问题。</em></h1>
    <p>架构图当然重要，但更值得记录的是：为什么这样选、怎么知道它有效，以及哪些结果不能被过度解释。</p>
  </header>

  <section class="post-section" aria-labelledby="all-posts-title">
    <div class="section-top">
      <h2 id="all-posts-title">全部文章</h2>
      <span>{String(posts.length).padStart(2, '0')} 篇</span>
    </div>
    <ol>
      {posts.map((post, index) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
            <div class="post-copy">
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="tags">{post.data.tags.slice(0, 4).map((tag) => <Tag label={tag} />)}</div>
            </div>
            <i aria-hidden="true">↗</i>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <p class="rss-note">偶尔更新，不追热点。你也可以通过 <a href="/rss.xml">RSS</a> 订阅。</p>
</BaseLayout>

<style>
  .page-head { max-width: 56rem; padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 8vw, 6rem); }
  h1 { max-width: 15ch; margin-top: .8rem; font-size: clamp(2.8rem, 6.5vw, 5.6rem); font-weight: 710; letter-spacing: -.065em; line-height: 1.04; }
  h1 em { position: relative; color: var(--color-primary-600); font-style: normal; }
  h1 em::after { position: absolute; right: 0; bottom: -.1em; left: 0; border-top: 2px solid currentColor; border-radius: 50%; content: ''; opacity: .5; transform: rotate(-2deg); }
  .page-head > p:last-child { max-width: 43rem; margin-top: 1.4rem; color: var(--muted-text); font-size: .94rem; line-height: 1.9; }
  .post-section { border-top: 1px solid var(--hairline); padding-top: 1.3rem; }
  .section-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .section-top h2 { font-size: .78rem; font-weight: 680; }
  .section-top span { color: var(--muted-text); font: 600 .63rem/1 var(--font-mono); }
  ol { margin: 1rem 0 0; padding: 0; list-style: none; }
  li { border-top: 1px solid var(--hairline); }
  li:last-child { border-bottom: 1px solid var(--hairline); }
  li a { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; gap: 1.25rem; color: inherit; padding: clamp(2rem, 5vw, 3.4rem) 0; text-decoration: none; }
  .post-index { color: var(--color-primary-600); font: 650 .65rem/1.6 var(--font-mono); }
  time { color: var(--muted-text); font: 550 .62rem/1.4 var(--font-mono); }
  h3 { max-width: 34ch; margin-top: .55rem; font-size: clamp(1.35rem, 3vw, 2rem); font-weight: 710; letter-spacing: -.035em; line-height: 1.3; transition: color 160ms ease; }
  .post-copy > p { max-width: 50rem; margin-top: .7rem; color: var(--muted-text); font-size: .84rem; line-height: 1.8; }
  .tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: 1rem; }
  li a > i { color: var(--muted-text); font-style: normal; transition: transform 160ms ease; }
  li a:hover h3 { color: var(--color-primary-600); }
  li a:hover > i { transform: translate(.18rem, -.18rem); }
  .rss-note { margin-top: 1.5rem; color: var(--muted-text); font-size: .72rem; }
  .rss-note a { color: var(--page-text); text-underline-offset: .2rem; }
  @media (max-width: 560px) { li a { grid-template-columns: 2rem minmax(0, 1fr) auto; gap: .65rem; } }
  @media (prefers-reduced-motion: reduce) { h3, li a > i { transition: none; } }
</style>
