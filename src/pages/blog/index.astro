---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tag from '../../components/Tag.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="项目笔记" description="记录 AI Agent 项目中的架构选择、验证证据与失败边界" active="/blog">
  <header class="page-head">
    <p class="eyebrow">FIELD NOTES</p>
    <h1>项目笔记</h1>
    <p>记录我在 EvoAgent 与 OA Evidence Agent 中做过的设计取舍。重点不是复述概念，而是说明系统为何这样实现、如何验证，以及哪些结论不能外推。</p>
  </header>

  <section class="post-section" aria-labelledby="all-posts-title">
    <div class="post-meta">
      <h2 id="all-posts-title">全部文章</h2>
      <span>{String(posts.length).padStart(2, '0')} NOTES</span>
    </div>
    <ol>
      {posts.map((post, index) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <div class="date-row">
                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
                <span aria-hidden="true">/</span>
                <span>PROJECT NOTE</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="tags">{post.data.tags.map((tag) => <Tag label={tag} />)}</div>
            </div>
            <i aria-hidden="true">↗</i>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .page-head { max-width: 54rem; padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(3.5rem, 7vw, 5.5rem); }
  .page-head h1 { margin-top: .75rem; font-size: clamp(2.8rem, 7vw, 5.5rem); font-weight: 780; letter-spacing: -.065em; line-height: 1; }
  .page-head > p:last-child { max-width: 48rem; margin-top: 1.35rem; color: var(--muted-text); font-size: .96rem; line-height: 1.9; }
  .post-section { border-top: 1px solid var(--hairline); padding-top: 1.5rem; }
  .post-meta { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .post-meta h2 { font-size: .83rem; font-weight: 690; }
  .post-meta span { color: var(--muted-text); font: 600 .63rem/1 var(--font-mono); letter-spacing: .08em; }
  ol { margin: 1rem 0 0; padding: 0; list-style: none; }
  li { border-top: 1px solid var(--hairline); }
  li:last-child { border-bottom: 1px solid var(--hairline); }
  li a { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1.2rem; color: inherit; padding: clamp(1.7rem, 4vw, 2.6rem) 0; text-decoration: none; }
  .post-index { color: var(--color-primary-500); font: 650 .68rem/1.5 var(--font-mono); }
  .date-row { display: flex; flex-wrap: wrap; gap: .5rem; color: var(--muted-text); font: 550 .63rem/1.4 var(--font-mono); letter-spacing: .04em; }
  h3 { max-width: 36ch; margin-top: .55rem; font-size: clamp(1.25rem, 2.7vw, 1.8rem); font-weight: 720; letter-spacing: -.03em; line-height: 1.3; transition: color 160ms ease; }
  li p { max-width: 50rem; margin-top: .65rem; color: var(--muted-text); font-size: .86rem; line-height: 1.75; }
  .tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .9rem; }
  li a > i { color: var(--muted-text); font-style: normal; transition: transform 160ms ease; }
  li a:hover h3 { color: var(--color-primary-600); }
  li a:hover > i { transform: translate(.15rem, -.15rem); }
  @media (max-width: 580px) { li a { grid-template-columns: 2rem 1fr auto; gap: .65rem; } }
  @media (prefers-reduced-motion: reduce) { h3, li a > i { transition: none; } }
</style>
