---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="我的文章" description="记录 AI Agent 工程中的设计选择、验证证据与失败边界。" active="/blog">
  <div class="site-wrapper page-shell">
    <header class="page-header"><h1>我的文章</h1></header>
    <section class="posts-panel" aria-label="文章列表">
      <ul>
        {posts.map((post, index) => (
          <li class={`shape-${(index % 3) + 1}`}>
            <a href={`/blog/${post.id}`}>
              <span>{post.data.title}</span>
              <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page-shell { max-width: 64rem; padding-block: 3rem 7rem; }
  .page-header { padding: 1rem 0 2.5rem; }
  h1 { margin: 0; font-family: var(--font-brand); font-size: clamp(2.1rem, 5vw, 3rem); font-weight: 680; letter-spacing: -.025em; }
  .posts-panel { border: 1px solid var(--hairline); border-radius: var(--radius-2xl); background: color-mix(in srgb, var(--surface) 62%, transparent); padding: 1.25rem; box-shadow: var(--shadow-sm); }
  ul { display: flex; flex-direction: column; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  li { border-radius: var(--radius-lg); transition: background .2s ease; }
  li:hover { background: var(--surface-soft); }
  a { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; color: inherit; padding: 1rem 1.1rem; text-decoration: none; }
  a > span { font-size: 1.05rem; font-weight: 520; line-height: 1.5; transition: color .2s ease; }
  li:hover a > span { color: var(--primary); }
  time { flex: none; color: var(--muted-text); font-size: .78rem; }
  @media (max-width: 600px) { .page-shell { padding-top: 2rem; } .posts-panel { padding: .75rem; } a { align-items: flex-start; flex-direction: column; gap: .3rem; padding: .9rem; } }
</style>
