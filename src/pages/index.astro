---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout title="首页" description={profile.tagline} active="/">
  <header class="home-intro">
    <div class="intro-copy">
      <p class="hello">你好，我是</p>
      <h1>朱佳明</h1>
      <p class="identity">东华大学计算机硕士在读，正在学习怎样把 AI Agent 做成可靠、可验证的工程系统。</p>
      <div class="roles" aria-label="身份与方向">
        <span>Agent Builder</span><span>Developer</span><span>Writer</span>
      </div>
      <nav class="intro-links" aria-label="个人链接">
        <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href={`mailto:${profile.email}`}>Email <span aria-hidden="true">↗</span></a>
        <a href="/about">关于我 <span aria-hidden="true">→</span></a>
      </nav>
    </div>
    <aside class="current-note" aria-label="当前状态">
      <span class="pin" aria-hidden="true"></span>
      <p class="note-title">NOW</p>
      <strong>在上海学习和做项目</strong>
      <p>最近围绕多智能体协作、可信 RAG 与评测方法继续迭代两个 Agent 项目。</p>
      <small><i aria-hidden="true"></i>开放 AI Agent 开发实习机会</small>
    </aside>
  </header>

  <section class="focus-grid" aria-label="关注方向">
    <article>
      <span aria-hidden="true">⌁</span>
      <h2>Agent 系统</h2>
      <p>让规划、工具调用、记忆与反思在明确预算内运行。</p>
    </article>
    <article>
      <span aria-hidden="true">◎</span>
      <h2>可信检索</h2>
      <p>让回答保留来源、降级状态与清晰的能力边界。</p>
    </article>
    <article>
      <span aria-hidden="true">✓</span>
      <h2>评测与验证</h2>
      <p>用测试、回放与证据门禁判断系统是否真的变好。</p>
    </article>
  </section>

  <section class="home-section" aria-labelledby="project-title">
    <header class="section-head">
      <div>
        <h2 id="project-title">最近项目</h2>
        <p>两个正在持续迭代的 AI Agent 工程项目。</p>
      </div>
      <a href="/projects">查看全部 <span aria-hidden="true">→</span></a>
    </header>
    <div class="project-grid">
      {profile.projects.map((project, index) => (
        <article class:list={['project-card', project.slug === 'oa' && 'oa-card']}>
          <a class="project-main" href={`/projects/${project.slug}`}>
            <div class="project-top">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <small>{project.year}</small>
            </div>
            <div class="mini-flow" aria-hidden="true">
              {project.flow.slice(0, 4).map((step) => <i>{step}</i>)}
            </div>
            <h3>{project.name}</h3>
            <p>{project.tagline}</p>
          </a>
          <div class="project-foot">
            <span>{project.tags.slice(0, 3).join(' · ')}</span>
            {project.repositoryPublic && <a href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`${project.name} GitHub 仓库`}>GitHub ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section writing" aria-labelledby="writing-title">
    <header class="section-head">
      <div>
        <h2 id="writing-title">最近文章</h2>
        <p>项目里的设计取舍、验证证据和失败边界。</p>
      </div>
      <a href="/blog">查看全部 <span aria-hidden="true">→</span></a>
    </header>
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`}>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="hello-again" aria-labelledby="hello-again-title">
    <div>
      <h2 id="hello-again-title">很高兴见到你！</h2>
      <p>如果你对项目有问题，或者想聊 Agent、实习和编程学习，欢迎随时联系我。</p>
    </div>
    <a href={`mailto:${profile.email}`}>联系我 <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .home-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(15rem, .42fr); align-items: center; gap: clamp(3rem, 9vw, 8rem); padding: clamp(4.25rem, 9vw, 7rem) 0 clamp(3.5rem, 7vw, 5rem); }
  .intro-copy { max-width: 47rem; }
  .hello { color: var(--muted-text); font-size: .82rem; }
  h1 { margin-top: .3rem; font-size: clamp(2.25rem, 5vw, 3.65rem); font-weight: 730; letter-spacing: -.055em; line-height: 1.08; }
  .identity { max-width: 39rem; margin-top: 1rem; color: var(--muted-text); font-size: clamp(.93rem, 1.35vw, 1rem); line-height: 1.9; }
  .roles { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.25rem; }
  .roles span { border-radius: 999px; color: #51469e; background: #eae6fb; padding: .35rem .6rem; font: 600 .65rem/1 var(--font-mono); }
  .intro-links { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-top: 1.4rem; }
  .intro-links a { color: var(--page-text); font-size: .76rem; font-weight: 650; text-underline-offset: .22rem; }
  .current-note { position: relative; border: 1px solid #d7d0bd; border-radius: .4rem 1rem 1rem .9rem; background: #fff9df; padding: 1.2rem; box-shadow: 0 1rem 2.5rem rgb(64 54 35 / .08); transform: rotate(1.2deg); }
  .current-note .pin { position: absolute; top: -.45rem; left: 42%; width: 3.2rem; height: .85rem; background: rgb(255 255 255 / .65); transform: rotate(-4deg); }
  .note-title { color: #807762; font: 650 .58rem/1 var(--font-mono); }
  .current-note strong { display: block; margin-top: .8rem; color: #3f3a31; font-size: .9rem; }
  .current-note > p:not(.note-title) { margin-top: .65rem; color: #726a59; font-size: .72rem; line-height: 1.75; }
  .current-note small { display: flex; align-items: center; gap: .45rem; border-top: 1px solid #dfd5b8; margin-top: .9rem; padding-top: .9rem; color: #537063; font-size: .62rem; font-weight: 620; }
  .current-note small i { width: .4rem; height: .4rem; border-radius: 50%; background: #2f9b76; box-shadow: 0 0 0 .18rem rgb(47 155 118 / .12); }
  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .focus-grid article { min-height: 10.5rem; padding: 1.5rem 1.6rem 1.5rem 0; }
  .focus-grid article + article { border-left: 1px solid var(--hairline); padding-left: 1.6rem; }
  .focus-grid article > span { color: var(--color-primary-600); font-size: 1rem; }
  .focus-grid h2 { margin-top: 1.5rem; font-size: .92rem; font-weight: 690; }
  .focus-grid p { max-width: 18rem; margin-top: .45rem; color: var(--muted-text); font-size: .75rem; line-height: 1.7; }
  .home-section { padding: clamp(4.5rem, 9vw, 7rem) 0 0; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.6rem; }
  .section-head h2, .hello-again h2 { font-size: clamp(1.45rem, 3vw, 2rem); font-weight: 710; letter-spacing: -.035em; }
  .section-head p { margin-top: .35rem; color: var(--muted-text); font-size: .76rem; }
  .section-head > a { flex: none; color: var(--page-text); font-size: .72rem; font-weight: 650; text-underline-offset: .22rem; }
  .project-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .project-card { overflow: hidden; border: 1px solid #d9d3eb; border-radius: 1rem; background: #eeeaf9; transition: transform 180ms ease, box-shadow 180ms ease; }
  .project-card.oa-card { border-color: #cddfd8; background: #e8f2ed; }
  .project-card:hover { transform: translateY(-.18rem); box-shadow: 0 1rem 2.4rem rgb(57 48 34 / .08); }
  .project-main { display: block; color: inherit; padding: 1.2rem; text-decoration: none; }
  .project-top { display: flex; justify-content: space-between; color: #70678b; font: 600 .58rem/1 var(--font-mono); }
  .mini-flow { display: flex; align-items: center; gap: .4rem; min-height: 5.5rem; margin-top: .75rem; }
  .mini-flow i { position: relative; border: 1px solid rgb(91 77 167 / .2); border-radius: 999px; color: #554d68; background: rgb(255 253 248 / .72); padding: .36rem .48rem; font: 550 .53rem/1 var(--font-mono); font-style: normal; }
  .mini-flow i + i::before { position: absolute; top: 50%; right: 100%; width: .42rem; border-top: 1px solid rgb(91 77 167 / .3); content: ''; }
  .project-card h3 { font-size: 1.2rem; font-weight: 710; letter-spacing: -.03em; }
  .project-card .project-main > p { max-width: 33rem; margin-top: .5rem; color: #645d72; font-size: .76rem; line-height: 1.75; }
  .project-foot { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid rgb(90 75 170 / .14); padding: .75rem 1.2rem; color: #70678b; font: 550 .56rem/1.4 var(--font-mono); }
  .project-foot a { flex: none; color: inherit; text-underline-offset: .2rem; }
  .oa-card .project-top, .oa-card .project-foot { color: #527365; }
  .oa-card .mini-flow i { border-color: rgb(50 112 87 / .18); color: #466458; }
  .oa-card .project-main > p { color: #587066; }
  .oa-card .project-foot { border-color: rgb(50 112 87 / .14); }
  .writing { padding-top: clamp(4.5rem, 9vw, 7rem); }
  .post-list { margin: 0; padding: 0; list-style: none; }
  .post-list li { border-top: 1px solid var(--hairline); }
  .post-list li:last-child { border-bottom: 1px solid var(--hairline); }
  .post-list a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 2rem; color: inherit; padding: 1.35rem 0; text-decoration: none; }
  .post-list h3 { font-size: .92rem; font-weight: 680; line-height: 1.55; transition: color 160ms ease; }
  .post-list p { max-width: 50rem; margin-top: .35rem; color: var(--muted-text); font-size: .74rem; line-height: 1.7; }
  .post-list time { color: var(--muted-text); font: 550 .6rem/1.5 var(--font-mono); }
  .post-list a:hover h3 { color: var(--color-primary-600); }
  .hello-again { display: flex; align-items: end; justify-content: space-between; gap: 2rem; border-top: 1px solid var(--hairline); margin-top: clamp(4.5rem, 9vw, 7rem); padding-top: clamp(3.5rem, 7vw, 5rem); }
  .hello-again p { margin-top: .5rem; color: var(--muted-text); font-size: .78rem; line-height: 1.75; }
  .hello-again a { flex: none; color: var(--page-text); font-size: .76rem; font-weight: 650; text-underline-offset: .22rem; }
  :global(.dark) .roles span { color: #cfc8ff; background: #302b42; }
  :global(.dark) .current-note { border-color: #5b513b; background: #352f20; }
  :global(.dark) .current-note strong { color: #f4ead0; }
  :global(.dark) .current-note > p:not(.note-title), :global(.dark) .note-title { color: #b7aa88; }
  :global(.dark) .project-card { border-color: #443d5d; background: #292535; }
  :global(.dark) .project-card.oa-card { border-color: #365147; background: #1f2b26; }
  :global(.dark) .mini-flow i { color: #ddd7ee; background: rgb(37 33 45 / .85); }
  :global(.dark) .oa-card .mini-flow i { color: #dcece5; background: rgb(34 47 42 / .9); }
  :global(.dark) .project-card .project-main > p { color: #aaa1b8; }
  :global(.dark) .oa-card .project-main > p { color: #9fb8ad; }
  @media (max-width: 760px) { .home-intro { grid-template-columns: 1fr; gap: 2.5rem; } .current-note { max-width: 24rem; } .focus-grid { grid-template-columns: 1fr; } .focus-grid article { min-height: auto; padding: 1.3rem 0; } .focus-grid article + article { border-top: 1px solid var(--hairline); border-left: 0; padding-left: 0; } .focus-grid h2 { margin-top: .7rem; } .project-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .home-intro { padding-top: 3.5rem; } .mini-flow { overflow: hidden; } .section-head, .hello-again { align-items: flex-start; flex-direction: column; gap: .9rem; } .post-list a { grid-template-columns: 1fr; gap: .5rem; } }
  @media (prefers-reduced-motion: reduce) { .project-card, .post-list h3 { transition: none; } }
</style>
