---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AgentWorkflow from '../components/AgentWorkflow.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const [evoAgent, oaAgent] = profile.projects;
---

<BaseLayout title="首页" description={profile.tagline} active="/">
  <div class="homepage">
    <section class="hero" data-hero>
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-aura aura-one" aria-hidden="true"></div>
      <div class="hero-aura aura-two" aria-hidden="true"></div>

      <div class="hero-layout shell">
        <div class="hero-content">
          <p class="hero-eyebrow">AI AGENT ENGINEERING</p>
          <h1>JimZhu</h1>
          <p class="hero-intro">关注智能体编排、可信检索与系统评测，希望把大模型能力做成可验证、可复现的工程系统。</p>

          <p class="hero-affiliation"><span aria-hidden="true"></span>Donghua University</p>

          <div class="hero-contact">
            <p>联系方式</p>
            <div class="hero-actions">
              <a href={profile.social.github} target="_blank" rel="noopener noreferrer"><span>GitHub</span><strong>JimmyZhu1420</strong><i aria-hidden="true">↗</i></a>
              <a href={`mailto:${profile.email}`}><span>邮箱</span><strong>{profile.email}</strong><i aria-hidden="true">↗</i></a>
            </div>
          </div>
        </div>

        <div class="core-scene" data-core role="img" aria-label="Agent 工作流示意：任务规划、工具调用和结果验证。">
          <div class="core-visual" aria-hidden="true">
            <div class="core-shadow"></div>
            <div class="core-system">
              <div class="orbit orbit-outer"><i></i><i></i></div>
              <div class="orbit orbit-middle"><i></i></div>
              <div class="orbit orbit-inner"><i></i><i></i><i></i></div>
              <div class="core-glow"></div>
              <div class="core-sphere">
                <div class="sphere-sheen"></div>
                <span>AGENT</span>
              </div>
            </div>
          </div>
          <AgentWorkflow />
        </div>
      </div>

      <a class="scroll-cue" href="#profile" aria-label="向下了解更多"><span></span></a>
    </section>

    <div class="theme-transition" aria-hidden="true"></div>

    <section id="profile" class="manifesto">
      <div class="shell">
        <p class="section-kicker" data-reveal>ABOUT</p>
        <h2 data-reveal>关于我</h2>
        <p class="manifesto-copy" data-reveal>我是东华大学计算机科学与技术专业硕士研究生，主要学习和实践 AI Agent 与大模型应用。比起一次看起来正确的回答，我更关心系统能否稳定完成任务，并留下清楚的验证依据。</p>

        <div class="principles" data-stagger>
          <article data-reveal>
            <span class="principle-index">01</span>
            <h3>Agent 工程</h3>
            <p>工作流编排、工具调用、记忆与可恢复执行。</p>
          </article>
          <article data-reveal>
            <span class="principle-index">02</span>
            <h3>可信检索</h3>
            <p>让回答保留来源、降级状态与清晰能力边界。</p>
          </article>
          <article data-reveal>
            <span class="principle-index">03</span>
            <h3>评测验证</h3>
            <p>用测试、回放与证据门禁判断系统是否改进。</p>
          </article>
        </div>
      </div>
    </section>

    <section class="project-showcase">
      <div class="shell">
        <header class="showcase-heading">
          <div>
            <p class="section-kicker light" data-reveal>RECENT WORK</p>
            <h2 data-reveal>近期工作</h2>
          </div>
        </header>

        <a class="project-feature evo-feature" href={`/projects/${evoAgent.slug}`} data-reveal>
          <div class="feature-copy">
            <p class="project-label">{evoAgent.eyebrow}</p>
            <h3>{evoAgent.name}</h3>
            <p class="project-lead">为 GitHub PR 构建可恢复、可评测、可审计的多智能体代码审查控制面。</p>
            <span class="project-link">深入了解 <b aria-hidden="true">›</b></span>
          </div>
          <div class="evo-visual" aria-hidden="true">
            <div class="review-window">
              <div class="review-head"><span>pull request #142</span><b>Reviewing</b></div>
              <div class="diff-line"><i>+</i><span>validate(tool_call)</span><em>Security</em></div>
              <div class="diff-line"><i>+</i><span>checkpoint.save()</span><em>Runtime</em></div>
              <div class="diff-line dim"><i>−</i><span>unbounded_retry()</span><em>Critic</em></div>
              <div class="agent-row"><span>Planner</span><i></i><span>Evidence</span><i></i><span>Verifier</span></div>
            </div>
          </div>
          <div class="feature-metrics">
            <div><strong>58 / 58</strong><span>自动化测试通过</span></div>
            <div><strong>100</strong><span>受控合成评测 Diff</span></div>
            <div><strong>6 阶段</strong><span>多 Agent 复核链路</span></div>
          </div>
        </a>

        <a class="project-feature oa-feature" href={`/projects/${oaAgent.slug}`} data-reveal>
          <div class="oa-glow" aria-hidden="true"></div>
          <div class="feature-copy">
            <p class="project-label">{oaAgent.eyebrow}</p>
            <h3>OA <span>Evidence Agent</span></h3>
            <p class="project-lead">把公开指南检索、研究级影像候选、事实校验与安全边界组织成一条可追溯工作流。</p>
            <span class="project-link">深入了解 <b aria-hidden="true">›</b></span>
          </div>
          <div class="evidence-visual" aria-hidden="true">
            <div class="evidence-core"><span>Evidence</span><b>TRACEABLE</b></div>
            <div class="evidence-pill pill-one">Hybrid RAG <i>✓</i></div>
            <div class="evidence-pill pill-two">Factuality <i>✓</i></div>
            <div class="evidence-pill pill-three">Safety Gate <i>✓</i></div>
            <svg viewBox="0 0 560 320" role="presentation"><path d="M118 88 C210 88 188 158 280 158" /><path d="M443 78 C342 78 370 158 280 158" /><path d="M438 248 C340 248 370 164 280 164" /></svg>
          </div>
          <div class="feature-metrics">
            <div><strong>166 + 1</strong><span>后端通过 / 跳过</span></div>
            <div><strong>35 / 35</strong><span>前端测试通过</span></div>
            <div><strong>7 个</strong><span>受约束 Agent 工具</span></div>
          </div>
        </a>

        <div class="all-projects" data-reveal><a class="button button-light" href="/projects">查看全部项目</a></div>
      </div>
    </section>

    <section class="writing-section">
      <div class="shell">
        <header class="writing-heading">
          <div>
            <p class="section-kicker" data-reveal>WRITING</p>
            <h2 data-reveal>近期文章</h2>
          </div>
          <a href="/blog" data-reveal>全部文章 <span aria-hidden="true">›</span></a>
        </header>

        <div class="post-list" data-stagger>
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} data-reveal>
              <div><span>工程笔记</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time></div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const core = document.querySelector<HTMLElement>('[data-core]');

  if (hero && core && !reduceMotion) {
    let scrollQueued = false;
    const updateHero = () => {
      const progress = Math.min(Math.max(window.scrollY / Math.max(hero.offsetHeight * .82, 1), 0), 1);
      hero.style.setProperty('--hero-progress', String(progress));
      scrollQueued = false;
    };
    window.addEventListener('scroll', () => {
      if (scrollQueued) return;
      scrollQueued = true;
      requestAnimationFrame(updateHero);
    }, { passive: true });
    updateHero();

    if (window.matchMedia('(pointer: fine)').matches) {
      hero.addEventListener('pointermove', (event) => {
        const rect = hero.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;
        core.style.setProperty('--pointer-x', String(x));
        core.style.setProperty('--pointer-y', String(y));
      });
      hero.addEventListener('pointerleave', () => {
        core.style.setProperty('--pointer-x', '0');
        core.style.setProperty('--pointer-y', '0');
      });
    }
  }

</script>

<style>
  .homepage { overflow: clip; color: var(--page-text); background: var(--surface); }
  .hero {
    --hero-progress: 0;
    position: relative;
    display: flex;
    min-height: calc(100svh - 52px);
    align-items: center;
    overflow: hidden;
    color: #f5f5f7;
    background: #000;
    padding: clamp(3.5rem, 7vh, 5.5rem) 0 2rem;
    isolation: isolate;
  }
  .hero-noise { position: absolute; z-index: -1; inset: 0; opacity: .16; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E"); mix-blend-mode: soft-light; pointer-events: none; }
  .hero-aura { position: absolute; z-index: -2; width: 45rem; height: 45rem; border-radius: 50%; filter: blur(110px); opacity: .22; pointer-events: none; }
  .aura-one { top: 25%; left: -28rem; background: #0066ff; animation: aura-breathe 8s ease-in-out infinite alternate; }
  .aura-two { top: 38%; right: -30rem; background: #8a2be2; animation: aura-breathe 10s ease-in-out -3s infinite alternate; }
  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(22rem, .72fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    opacity: calc(1 - var(--hero-progress) * 1.35);
    transform: translate3d(0, calc(var(--hero-progress) * -52px), 0);
    will-change: opacity, transform;
  }
  .js .hero-content > * { opacity: 0; animation: hero-line-in .9s var(--ease-premium) forwards; }
  .js .hero-content > :nth-child(1) { animation-delay: .08s; }
  .js .hero-content > :nth-child(2) { animation-delay: .16s; }
  .js .hero-content > :nth-child(3) { animation-delay: .24s; }
  .js .hero-content > :nth-child(4) { animation-delay: .32s; }
  .js .hero-content > :nth-child(5) { animation-delay: .4s; }
  .hero-eyebrow { margin: 0 0 1.2rem; color: #7eb8ff; font-size: clamp(.72rem, 1vw, .84rem); font-weight: 650; letter-spacing: .13em; }
  .hero h1 { margin: 0; font-size: clamp(2.55rem, 3.8vw, 3.5rem); font-weight: 650; letter-spacing: -.057em; line-height: 1.02; }
  .hero-intro { max-width: 37rem; margin: 1.2rem 0 0; color: #a1a1a6; font-size: clamp(.95rem, 1.25vw, 1.08rem); line-height: 1.7; letter-spacing: -.01em; }
  .hero-affiliation { display: inline-flex; align-items: center; gap: .55rem; margin: 1.35rem 0 0; border: 1px solid rgb(255 255 255 / .1); border-radius: 999px; color: #a1a1a6; background: rgb(255 255 255 / .035); padding: .48rem .72rem; font-size: .7rem; letter-spacing: .025em; }
  .hero-affiliation span { width: .35rem; height: .35rem; border-radius: 50%; background: #2997ff; box-shadow: 0 0 12px rgb(41 151 255 / .72); animation: affiliation-pulse 2.8s ease-in-out infinite; }
  .hero-contact { margin-top: 1.5rem; }
  .hero-contact > p { margin: 0 0 .65rem; color: #6e6e73; font-size: .7rem; }
  .hero-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
  .hero-actions a { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .65rem; border: 1px solid rgb(255 255 255 / .12); border-radius: .8rem; color: #f5f5f7; background: rgb(255 255 255 / .04); padding: .72rem .8rem; text-decoration: none; transition: border-color .3s ease, background .3s ease, transform .3s var(--ease-premium); }
  .hero-actions a:hover { border-color: rgb(41 151 255 / .42); background: rgb(41 151 255 / .08); transform: translateY(-2px); }
  .hero-actions span { color: #7eb8ff; font-size: .66rem; font-weight: 600; }
  .hero-actions strong { overflow: hidden; color: #c7c7cc; font-size: .69rem; font-weight: 480; text-overflow: ellipsis; white-space: nowrap; }
  .hero-actions i { color: #2997ff; font-size: .72rem; font-style: normal; transition: transform .3s var(--ease-premium); }
  .hero-actions a:hover i { transform: translate3d(2px, -2px, 0); }
  .button { display: inline-flex; min-height: 2.9rem; align-items: center; justify-content: center; border-radius: 999px; padding: .7rem 1.35rem; font-size: .93rem; font-weight: 500; text-decoration: none; transition: background .3s ease, color .3s ease, transform .3s var(--ease-premium), box-shadow .3s ease; }
  .button:hover { transform: scale(1.035); }
  .button-primary { color: #fff; background: #0071e3; box-shadow: 0 0 0 0 rgb(0 113 227 / 0); }
  .button-primary:hover { background: #0077ed; box-shadow: 0 12px 34px rgb(0 113 227 / .3); }
  .button-light { color: #1d1d1f; background: #fff; }
  .core-scene {
    --pointer-x: 0;
    --pointer-y: 0;
    position: relative;
    z-index: 1;
    width: min(34vw, 28rem);
    justify-self: end;
    opacity: calc(1 - var(--hero-progress) * .65);
    transform: translate3d(0, calc(var(--hero-progress) * 76px), 0) scale(calc(1 - var(--hero-progress) * .08));
    will-change: opacity, transform;
  }
  .core-visual { position: relative; width: 100%; aspect-ratio: 1; perspective: 1000px; }
  .core-shadow { position: absolute; right: 16%; bottom: 3%; left: 16%; height: 13%; border-radius: 50%; background: rgb(36 127 255 / .24); filter: blur(30px); transform: rotateX(70deg); }
  .core-system {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    transform: rotateX(calc(var(--pointer-y) * -9deg)) rotateY(calc(var(--pointer-x) * 11deg));
    transition: transform .6s var(--ease-premium);
    transform-style: preserve-3d;
    animation: core-float 5.5s ease-in-out infinite;
  }
  .orbit { position: absolute; border: 1px solid rgb(170 210 255 / .2); border-radius: 50%; transform-style: preserve-3d; }
  .orbit::before { position: absolute; inset: -1px; border: 1px solid transparent; border-top-color: rgb(112 184 255 / .6); border-radius: inherit; content: ''; }
  .orbit i { position: absolute; display: block; width: .55rem; height: .55rem; border: 2px solid rgb(255 255 255 / .9); border-radius: 50%; background: #1687ff; box-shadow: 0 0 16px #1687ff, 0 0 32px rgb(22 135 255 / .65); }
  .orbit-outer { inset: 2%; transform: rotateX(64deg) rotateZ(8deg); animation: orbit-one 17s linear infinite; }
  .orbit-outer i:first-child { top: 8%; left: 22%; }
  .orbit-outer i:last-child { right: 8%; bottom: 22%; width: .38rem; height: .38rem; background: #b176ff; box-shadow: 0 0 16px #a55cff; }
  .orbit-middle { inset: 15%; transform: rotateY(68deg) rotateZ(-20deg); animation: orbit-two 12s linear infinite reverse; }
  .orbit-middle i { top: 48%; left: -1%; background: #7e57ff; box-shadow: 0 0 18px #7e57ff; }
  .orbit-inner { inset: 27%; transform: rotateX(58deg) rotateY(20deg); animation: orbit-one 9s linear infinite reverse; }
  .orbit-inner i:nth-child(1) { top: 3%; left: 47%; }
  .orbit-inner i:nth-child(2) { right: 5%; bottom: 21%; width: .34rem; height: .34rem; }
  .orbit-inner i:nth-child(3) { bottom: 12%; left: 16%; width: .28rem; height: .28rem; background: #fff; box-shadow: 0 0 14px #fff; }
  .core-glow { position: absolute; inset: 29%; border-radius: 50%; background: radial-gradient(circle at 38% 34%, #fff 0, #a4d7ff 8%, #1979ed 35%, #42198c 72%, transparent 73%); filter: blur(12px); opacity: .68; animation: core-pulse 4s ease-in-out infinite; }
  .core-sphere { position: absolute; display: grid; inset: 34%; place-items: center; overflow: hidden; border: 1px solid rgb(255 255 255 / .34); border-radius: 50%; color: rgb(255 255 255 / .9); background: radial-gradient(circle at 34% 24%, #d9f3ff 0, #4e9af7 18%, #18244b 48%, #080b16 76%); box-shadow: inset -16px -18px 38px rgb(0 0 0 / .48), inset 10px 12px 28px rgb(255 255 255 / .14), 0 0 56px rgb(52 132 255 / .38); font: 650 .62rem/1 var(--font-mono); letter-spacing: .19em; }
  .sphere-sheen { position: absolute; top: 8%; left: 18%; width: 46%; height: 25%; border-radius: 50%; background: linear-gradient(180deg, rgb(255 255 255 / .6), transparent); filter: blur(9px); transform: rotate(-23deg); }
  .scroll-cue { position: absolute; z-index: 3; bottom: 1.2rem; left: 50%; display: grid; width: 2rem; height: 2.8rem; place-items: center; transform: translateX(-50%); }
  .scroll-cue span { position: relative; width: 1px; height: 1.4rem; overflow: hidden; background: rgb(255 255 255 / .22); }
  .scroll-cue span::after { position: absolute; inset: -100% 0 auto; height: 60%; background: #fff; content: ''; animation: scroll-drop 2s ease-in-out infinite; }

  .theme-transition {
    position: relative;
    height: clamp(3.5rem, 5vw, 4.75rem);
    overflow: hidden;
    background: #000;
    pointer-events: none;
  }
  .theme-transition::before {
    position: absolute;
    top: .75rem;
    right: 50%;
    bottom: -1px;
    width: 140%;
    border-radius: 50% 50% 0 0 / 3.2rem 3.2rem 0 0;
    background: var(--surface);
    box-shadow: 0 -18px 60px rgb(41 151 255 / .09);
    content: '';
    transform: translateX(50%);
  }
  .manifesto { color: var(--page-text); background: var(--surface); padding: clamp(4.75rem, 8vw, 7rem) 0 clamp(6rem, 10vw, 9rem); }
  .section-kicker { margin: 0 0 1.4rem; color: var(--primary); font-size: .77rem; font-weight: 650; letter-spacing: .13em; }
  .section-kicker.light { color: #2997ff; }
  .manifesto h2, .showcase-heading h2, .writing-heading h2 { margin: 0; font-size: clamp(2.25rem, 4vw, 3.25rem); font-weight: 640; letter-spacing: -.05em; line-height: 1.05; text-wrap: balance; }
  .manifesto-copy { max-width: 46rem; margin: 1.8rem 0 0; color: var(--muted-text); font-size: clamp(1.08rem, 1.7vw, 1.28rem); line-height: 1.65; letter-spacing: -.018em; }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: clamp(4rem, 7vw, 6rem); border-top: 1px solid var(--hairline); }
  .principles article { padding: 2rem 2.3rem 0 0; }
  .principles article + article { border-left: 1px solid var(--hairline); padding-left: 2.3rem; }
  .principle-index { color: #86868b; font-size: .7rem; font-weight: 600; letter-spacing: .08em; }
  .principles h3 { margin: 1.25rem 0 .75rem; font-size: clamp(1.45rem, 2.5vw, 2rem); font-weight: 620; letter-spacing: -.04em; }
  .principles p { max-width: 18rem; margin: 0; color: var(--muted-text); font-size: 1rem; line-height: 1.6; }

  .project-showcase { color: #f5f5f7; background: #000; padding: clamp(6rem, 10vw, 9rem) 0; }
  .showcase-heading { margin-bottom: 3rem; }
  .project-feature { position: relative; display: grid; min-height: 41rem; grid-template-columns: 1fr 1.12fr; overflow: hidden; border-radius: 2.75rem; color: inherit; background: #101012; padding: clamp(2rem, 4vw, 4rem); text-decoration: none; box-shadow: inset 0 1px 0 rgb(255 255 255 / .1); transition: transform .7s var(--ease-premium), box-shadow .7s ease; isolation: isolate; }
  .project-feature + .project-feature { margin-top: 2rem; }
  .project-feature:hover { transform: scale(1.008); box-shadow: 0 40px 100px rgb(0 0 0 / .38), inset 0 1px 0 rgb(255 255 255 / .14); }
  .feature-copy { position: relative; z-index: 2; align-self: start; }
  .project-label { margin: 0 0 1.25rem; color: #86868b; font-size: .7rem; font-weight: 600; letter-spacing: .12em; }
  .feature-copy h3 { margin: 0; font-size: clamp(2.7rem, 4.5vw, 3.6rem); font-weight: 650; letter-spacing: -.058em; line-height: .98; }
  .feature-copy h3 span { display: block; }
  .project-lead { max-width: 32rem; margin: 1.6rem 0 0; color: #a1a1a6; font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.55; }
  .project-link { display: inline-block; margin-top: 1.6rem; color: #2997ff; font-size: 1rem; }
  .project-link b { display: inline-block; margin-left: .2rem; font-size: 1.35rem; font-weight: 400; transition: transform .3s var(--ease-premium); }
  .project-feature:hover .project-link b { transform: translateX(4px); }
  .feature-metrics { position: absolute; z-index: 3; right: clamp(2rem, 4vw, 4rem); bottom: clamp(2rem, 4vw, 3.3rem); left: clamp(2rem, 4vw, 4rem); display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; border-top: 1px solid rgb(255 255 255 / .12); padding-top: 1.5rem; }
  .feature-metrics div { display: flex; flex-direction: column; gap: .35rem; }
  .feature-metrics strong { font-size: clamp(1.5rem, 2.8vw, 2.25rem); font-weight: 600; letter-spacing: -.04em; }
  .feature-metrics span { color: #86868b; font-size: .72rem; }
