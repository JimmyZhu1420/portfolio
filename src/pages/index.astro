---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const avatarUrl = 'https://github.com/JimmyZhu1420.png?size=480';
const focuses = [
  { icon: '⌘', title: 'Agent 工程', description: '关注工作流编排、工具调用、记忆与可恢复执行。' },
  { icon: '◎', title: '可信 RAG', description: '让回答带回来源、降级状态与清晰的能力边界。' },
  { icon: '✓', title: '评测验证', description: '用测试、回放与证据门禁判断系统是否真的变好。' },
];
---

<BaseLayout title="首页" description={profile.tagline} active="/">
  <div class="page-wrapper">
    <section class="hero-section">
      <div class="site-wrapper">
        <div class="hero-grid">
          <div class="hero-copy">
            <h1>{profile.name}</h1>
            <p>{profile.role}。<br />关注智能体编排、可信检索与系统评测。</p>
            <div class="roles" aria-label="身份标签"><span>⌘ Developer</span><span>✎ Writer</span></div>
          </div>
          <div class="avatar-wrap"><img src={avatarUrl} alt={`${profile.name}的头像`} width="240" height="240" /></div>
        </div>
      </div>
    </section>

    <section class="skills-section site-wrapper" aria-label="关注方向">
      <div class="skills-grid">
        {focuses.map((focus, index) => (
          <article class={`shape-${index + 1}`}>
            <span class="skill-icon" aria-hidden="true">{focus.icon}</span>
            <h2>{focus.title}</h2>
            <p>{focus.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-space">
      <div class="site-wrapper">
        <div class="posts-card">
          <header class="section-header">
            <div><h2>精选文章</h2><p>这里记录我做 Agent 项目时的设计取舍、验证方法和能力边界。</p></div>
            <a class="outline-button" href="/blog">查看全部 <span aria-hidden="true">→</span></a>
          </header>
          <ul class="posts-list">
            {posts.map((post) => (
              <li><a href={`/blog/${post.id}`}><span>{post.data.title}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time></a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section-space">
      <div class="site-wrapper">
        <header class="section-header project-header">
          <div><h2>最近项目</h2><p>两个围绕 Agent 可靠性持续迭代的工程项目。</p></div>
          <a class="outline-button" href="/projects">查看全部 <span aria-hidden="true">→</span></a>
        </header>
        <div class="projects-grid">
          {profile.projects.map((project, index) => (
            <a class={`project-card shape-${index + 1}`} href={`/projects/${project.slug}`}>
              <h3>{project.name}</h3>
              <p>{project.tagline}</p>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <aside class="contact-section">
      <div class="site-wrapper">
        <div class="contact-card">
          <span class="contact-icon" aria-hidden="true">✦</span>
          <div><h2>很高兴见到你！</h2><p>有任何问题或想法，欢迎随时联系我交流。</p></div>
          <a class="primary-button" href="/about">联系我 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-wrapper { overflow: hidden; }
  .hero-section { padding-block: 3rem; }
  .hero-grid { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 3rem; max-width: 56rem; margin: 0 auto; }
  .hero-copy h1 { margin: 0; font-size: 1.875rem; font-weight: 720; line-height: 1.2; }
  .hero-copy > p { max-width: 40ch; margin-top: .75rem; color: var(--muted-text); font-size: clamp(1.12rem, 2.2vw, 1.55rem); line-height: 1.55; }
  .roles { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
  .roles span { border-radius: 999px; padding: .48rem .85rem; font-size: .78rem; font-weight: 600; }
  .roles span:first-child { color: var(--primary-contrast); background: var(--primary); }
  .roles span:last-child { color: #fff; background: var(--secondary); }
  .avatar-wrap { position: relative; }
  .avatar-wrap::before { position: absolute; z-index: -1; inset: -1rem; border-radius: 65% 35% 46% 54% / 42% 60% 40% 58%; background: var(--surface-soft); content: ''; transform: rotate(5deg); }
  .avatar-wrap img { width: 240px; height: 240px; border: 4px solid var(--page-bg); border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; object-fit: cover; box-shadow: var(--shadow-lg); transition: transform .3s ease; }
  .avatar-wrap img:hover { transform: rotate(-2deg) scale(1.02); }
  .skills-section { padding-block: 2rem; }
  .skills-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .skills-grid article { display: flex; min-height: 13rem; flex-direction: column; gap: 1rem; border: 1px solid var(--hairline); background: var(--surface-soft); padding: 1.5rem; transition: transform .3s ease, box-shadow .3s ease; }
  .skills-grid article:hover { transform: translateY(-.2rem); box-shadow: var(--shadow-md); }
  .shape-1 { border-radius: var(--radius-3xl) var(--radius-lg) var(--radius-2xl) var(--radius-xl); }
  .shape-2 { border-radius: var(--radius-xl) var(--radius-2xl) var(--radius-lg) var(--radius-3xl); }
  .shape-3 { border-radius: var(--radius-lg) var(--radius-3xl) var(--radius-xl) var(--radius-2xl); }
  .skill-icon { display: grid; width: 3.5rem; height: 3.5rem; place-items: center; border-radius: var(--radius-xl); color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); font-size: 1.35rem; font-weight: 700; transition: color .2s ease, background .2s ease; }
  .skills-grid article:hover .skill-icon { color: var(--primary-contrast); background: var(--primary); }
  .skills-grid h2, .section-header h2, .contact-card h2 { font-family: var(--font-brand); font-size: 1.6rem; font-weight: 650; }
  .skills-grid p { color: var(--muted-text); font-size: .95rem; line-height: 1.65; }
  .section-space { padding-block: 2rem; }
  .posts-card { border: 1px solid var(--hairline); border-radius: var(--radius-2xl); background: color-mix(in srgb, var(--surface) 60%, transparent); padding: 3rem; box-shadow: var(--shadow-sm); }
  .section-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .section-header > div { display: flex; flex-direction: column; gap: .5rem; }
  .section-header p { color: var(--muted-text); font-size: .95rem; }
  .outline-button, .primary-button { display: inline-flex; flex: none; align-items: center; justify-content: center; gap: .55rem; border-radius: 999px; padding: .78rem 1.25rem; font-size: .84rem; font-weight: 650; text-decoration: none; transition: transform .2s ease, color .2s ease, background .2s ease; }
  .outline-button { border: 2px solid var(--primary); color: var(--primary); }
  .outline-button:hover { color: var(--primary-contrast); background: var(--primary); transform: scale(1.03); }
  .primary-button { color: var(--primary-contrast); background: var(--primary); box-shadow: var(--shadow-md); }
  .primary-button:hover { transform: scale(1.03); }
  .posts-list { display: flex; flex-direction: column; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .posts-list li { border-radius: var(--radius-lg); }
  .posts-list li:hover { background: var(--surface-soft); }
  .posts-list a { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; color: inherit; padding: 1rem; text-decoration: none; }
  .posts-list a > span { font-size: 1.08rem; font-weight: 520; }
  .posts-list li:hover a > span { color: var(--primary); }
  .posts-list time { flex: none; color: var(--muted-text); font-size: .78rem; }
  .project-header { margin-bottom: 2rem; }
  .projects-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .project-card { position: relative; display: flex; min-height: 12rem; flex-direction: column; gap: .75rem; overflow: hidden; border: 1px solid var(--hairline); color: inherit; background: var(--surface-soft); padding: 1.5rem; text-decoration: none; transition: transform .3s ease, box-shadow .3s ease; }
  .project-card:hover { transform: translateY(-.25rem); box-shadow: var(--shadow-md); }
  .project-card h3 { font-family: var(--font-brand); font-size: 1.6rem; font-weight: 650; transition: color .2s ease; }
  .project-card:hover h3 { color: var(--primary); }
  .project-card p { max-width: 36rem; color: var(--muted-text); font-size: .95rem; line-height: 1.65; }
  .project-card > span { position: absolute; right: 1.5rem; bottom: 1.35rem; color: var(--primary); font-size: 1.3rem; }
  .contact-section { padding: 4rem 0; }
  .contact-card { display: flex; align-items: center; gap: 1.5rem; border: 1px solid var(--hairline); border-radius: var(--radius-2xl); background: var(--surface-soft); padding: 3rem; }
  .contact-icon { display: grid; width: 4rem; height: 4rem; flex: none; place-items: center; border-radius: var(--radius-xl); color: var(--primary-contrast); background: var(--primary); font-size: 1.25rem; }
  .contact-card > div { flex: 1; }
  .contact-card p { margin-top: .45rem; color: var(--muted-text); }
  @media (max-width: 799px) {
    .hero-section { padding-block: 2rem; }
    .hero-grid { display: flex; flex-direction: column-reverse; gap: 1.5rem; text-align: center; }
    .hero-copy > p { margin-inline: auto; font-size: 1.1rem; }
    .roles { justify-content: center; }
    .avatar-wrap img { width: 160px; height: 160px; }
    .skills-grid, .projects-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .skills-grid article { min-height: auto; }
    .posts-card { padding: 2rem 1.25rem; }
    .section-header { align-items: flex-start; flex-direction: column; gap: 1.25rem; }
    .contact-card { align-items: center; flex-direction: column; padding: 2.5rem 1.5rem; text-align: center; }
  }
  @media (max-width: 520px) { .posts-list a { align-items: flex-start; flex-direction: column; gap: .35rem; } }
</style>
