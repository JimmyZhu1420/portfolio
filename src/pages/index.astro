---
import { getCollection } from 'astro:content';
import AgentLoopVisual from '../components/AgentLoopVisual.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Tag from '../components/Tag.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="首页" description={profile.tagline} active="/">
  <section class="hero">
    <div class="hero-copy">
      <p class="status-line"><i aria-hidden="true"></i>正在寻找 AI Agent 开发实习机会</p>
      <p class="eyebrow">HELLO, I'M {profile.name}</p>
      <h1>让 Agent 不只会回答，<br /><span>还能够可靠地完成任务。</span></h1>
      <p class="hero-intro">
        {profile.role}。我聚焦 Agent Runtime、多智能体协作、可信 RAG 与评测可观测性，
        把大模型能力落成可验证、可复现的工程系统。
      </p>
      <div class="hero-actions">
        <a class="primary" href="/projects">查看代表项目 <span aria-hidden="true">→</span></a>
        <a href={profile.social.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={`mailto:${profile.email}`}>联系我</a>
      </div>
      <ul class="hero-proof" aria-label="作品集概览">
        <li><strong>02</strong><span>完整 Agent 项目</span></li>
        <li><strong>GitHub</strong><span>EvoAgent 已公开</span></li>
        <li><strong>Evidence</strong><span>测试与运行证据</span></li>
      </ul>
    </div>
    <AgentLoopVisual />
  </section>

  <section class="section-shell section-rule" aria-labelledby="focus-title">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">WHAT I WORK ON</p>
        <h2 id="focus-title">我关注的问题</h2>
      </div>
      <p>从模型能力到可靠系统，中间还有运行时、证据、评测和工程交付。</p>
    </div>
    <div class="capability-grid">
      {profile.capabilities.map((capability) => (
        <a class="capability-card" href={capability.href}>
          <span class="capability-index">{capability.index}</span>
          <h3>{capability.title}</h3>
          <p>{capability.description}</p>
          <div>{capability.technologies.map((technology) => <Tag label={technology} />)}</div>
          <small>{capability.evidence} <i aria-hidden="true">→</i></small>
        </a>
      ))}
    </div>
  </section>

  <section class="section-shell section-rule" aria-labelledby="project-title">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2 id="project-title">代表项目</h2>
      </div>
      <p>两个项目分别验证 Agent Runtime 与可信证据链；EvoAgent 已公开源码，两者都明确工程边界。</p>
    </div>
    <div class="project-list">
      {profile.projects.map((project, index) => <ProjectCard project={project} reverse={index % 2 === 1} />)}
    </div>
    <a class="section-link" href="/projects">查看完整项目说明 <span aria-hidden="true">→</span></a>
  </section>

  {
    posts.length > 0 && (
      <section class="section-shell section-rule" aria-labelledby="writing-title">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">FIELD NOTES</p>
            <h2 id="writing-title">项目笔记</h2>
          </div>
          <a class="section-link inline" href="/blog">全部文章 <span aria-hidden="true">→</span></a>
        </div>
        <div class="post-list">
          {posts.map((post, index) => (
            <a href={`/blog/${post.id}`}>
              <span class="post-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
              </div>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="about-strip section-rule" aria-labelledby="about-title">
    <p class="eyebrow">A LITTLE MORE</p>
    <div>
      <h2 id="about-title">在上海学习，也在持续把想法做成系统。</h2>
      <div>
        <p>{profile.about[0]}</p>
        <a class="section-link inline" href="/about">更多关于我 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(21rem, .92fr); align-items: center; gap: clamp(3rem, 7vw, 6.5rem); min-height: calc(100vh - 4.25rem); padding: clamp(4.5rem, 9vw, 7.5rem) 0; }
  .hero-copy { max-width: 42rem; }
  .status-line { display: inline-flex; align-items: center; gap: .5rem; margin-bottom: 2.3rem; border: 1px solid #dce4df; border-radius: 999px; color: #3c5b51; background: rgb(240 253 249 / .72); padding: .42rem .72rem; font-size: .72rem; font-weight: 600; }
  .status-line i { width: .45rem; height: .45rem; border-radius: 50%; background: #10a37f; box-shadow: 0 0 0 .22rem rgb(16 163 127 / .13); }
  h1 { max-width: 13ch; margin-top: .9rem; font-size: clamp(2.65rem, 6vw, 5.35rem); font-weight: 780; letter-spacing: -.065em; line-height: 1.02; }
  h1 span { color: #667085; }
  .hero-intro { max-width: 42rem; margin-top: 1.6rem; color: var(--muted-text); font-size: clamp(.98rem, 1.5vw, 1.08rem); line-height: 1.9; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin-top: 2rem; }
  .hero-actions a { display: inline-flex; min-height: 2.9rem; align-items: center; gap: .45rem; border: 1px solid var(--hairline); border-radius: 999px; color: var(--page-text); background: var(--surface); padding: 0 1.05rem; font-size: .84rem; font-weight: 650; text-decoration: none; transition: transform 160ms ease, border-color 160ms ease; }
  .hero-actions a:hover { transform: translateY(-.15rem); border-color: #9d93ff; }
  .hero-actions a.primary { border-color: #111827; color: #fff; background: #111827; }
  .hero-actions a.text-link { border-color: transparent; background: transparent; text-decoration: underline; text-underline-offset: .25rem; }
  .hero-proof { display: flex; flex-wrap: wrap; gap: 1.6rem; margin: 2.4rem 0 0; padding: 0; list-style: none; }
  .hero-proof li { display: flex; flex-direction: column; gap: .16rem; }
  .hero-proof strong { color: #273244; font: 700 .75rem/1.2 var(--font-mono); }
  .hero-proof span { color: var(--muted-text); font-size: .68rem; }

  .section-heading h2, .about-strip h2 { margin-top: .65rem; font-size: clamp(2rem, 4vw, 3.3rem); font-weight: 760; letter-spacing: -.05em; line-height: 1.12; }
  .split-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 2.5rem; }
  .split-heading > p { max-width: 28rem; color: var(--muted-text); font-size: .9rem; line-height: 1.8; }
  .capability-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 3rem; }
  .capability-card { display: flex; min-height: 20rem; flex-direction: column; border: 1px solid var(--hairline); border-radius: 1.25rem; color: inherit; background: color-mix(in srgb, var(--surface) 86%, transparent); padding: 1.4rem; text-decoration: none; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .capability-card:hover { transform: translateY(-.25rem); border-color: #b3abff; box-shadow: 0 20px 50px rgb(31 41 55 / .08); }
  .capability-index { color: #8075ee; font: 650 .66rem/1 var(--font-mono); }
  .capability-card h3 { margin-top: 2rem; font-size: 1.2rem; font-weight: 720; letter-spacing: -.025em; }
  .capability-card > p { margin-top: .75rem; color: var(--muted-text); font-size: .85rem; line-height: 1.8; }
  .capability-card > div { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: 1.2rem; }
  .capability-card small { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 1.4rem; color: #4e5b6b; font-size: .73rem; font-weight: 650; }
  .capability-card small i { font-style: normal; }
  .project-list { margin-top: 1rem; }
  .section-link { display: inline-flex; align-items: center; gap: .45rem; margin-top: 1.25rem; color: var(--page-text); font-size: .82rem; font-weight: 680; text-decoration: underline; text-underline-offset: .28rem; }
  .section-link.inline { margin-top: 0; }

  .post-list { margin-top: 2.75rem; border-top: 1px solid var(--hairline); }
  .post-list a { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem; align-items: start; border-bottom: 1px solid var(--hairline); color: inherit; padding: 1.5rem 0; text-decoration: none; }
  .post-index { color: #8a96a6; font: 600 .68rem/1.5 var(--font-mono); }
  .post-list h3 { font-size: 1.05rem; font-weight: 690; letter-spacing: -.018em; }
  .post-list p { max-width: 48rem; margin-top: .35rem; color: var(--muted-text); font-size: .82rem; line-height: 1.65; }
  .post-list time { display: block; margin-top: .55rem; color: #7c899a; font: 500 .65rem/1 var(--font-mono); }
  .post-list a > i { color: #7c899a; font-style: normal; transition: transform 160ms ease; }
  .post-list a:hover > i { transform: translate(.15rem, -.15rem); }
  .post-list a:hover h3 { color: var(--color-primary-600); }

  .about-strip { padding: clamp(4rem, 9vw, 7.5rem) 0 1rem; }
  .about-strip > div { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 7vw, 6rem); align-items: start; margin-top: .65rem; }
  .about-strip h2 { max-width: 15ch; margin-top: 0; }
  .about-strip div > div p { color: var(--muted-text); font-size: .92rem; line-height: 1.9; }

  :global(.dark) h1 span { color: #9aa8ba; }
  :global(.dark) .status-line { border-color: #175e51; color: #9de8d3; background: rgb(6 78 59 / .22); }
  :global(.dark) .hero-actions a.primary { border-color: #f8fafc; color: #111827; background: #f8fafc; }
  :global(.dark) .hero-proof strong { color: #e8edf5; }
  :global(.dark) .capability-card small { color: #a8b4c4; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero-copy { max-width: 47rem; }
    .hero :global(.loop-visual) { max-width: 38rem; }
    .capability-grid { grid-template-columns: 1fr; }
    .capability-card { min-height: auto; }
    .capability-card small { margin-top: 1.5rem; }
  }

  @media (max-width: 680px) {
    .hero { padding-block: 4rem; }
    .status-line { margin-bottom: 1.8rem; }
    .hero-actions a.primary, .hero-actions a:not(.text-link) { justify-content: center; }
    .hero-proof { gap: 1.1rem; }
    .split-heading { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .about-strip > div { grid-template-columns: 1fr; }
    .post-list a { grid-template-columns: 2rem 1fr auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-actions a, .capability-card, .post-list a > i { transition: none; }
  }
</style>
