---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProject, profile } from '../../data/profile';

export function getStaticPaths() { return profile.projects.map((project) => ({ params: { slug: project.slug } })); }
const project = getProject(Astro.params.slug ?? '');
if (!project) return Astro.redirect('/404');
const articleHref = project.slug === 'evoagent' ? '/blog/evoagent-runtime' : '/blog/oa-evidence-agent';
---

<BaseLayout title={project.name} description={project.tagline} active="/projects" socialImage={null}>
  <div class="site-wrapper detail-shell">
    <article>
      <a class="back-link" href="/projects">← 返回项目列表</a>
      <header class="project-header">
        <h1>{project.name}</h1>
        <p>{project.title}</p>
        <div class="project-actions">
          {project.repositoryPublic ? <a class="primary" href={project.github} target="_blank" rel="noopener noreferrer">查看 GitHub <span aria-hidden="true">↗</span></a> : <span>仓库待公开</span>}
          <a href={articleHref}>阅读项目文章 <span aria-hidden="true">→</span></a>
        </div>
      </header>

      <section class="overview">
        <p>{project.description}</p>
        <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
        <dl>{project.metrics.map((metric) => <div><dd>{metric.value}</dd><dt>{metric.label}</dt></div>)}</dl>
      </section>

      <section class="content-section">
        <h2>为什么做这个项目</h2>
        {project.challenge.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      <section class="content-section">
        <h2>我实现了什么</h2>
        <div class="build-grid">
          {project.build.map((item, index) => <section class={`shape-${(index % 3) + 1}`}><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></section>)}
        </div>
      </section>

      <section class="content-section">
        <h2>一次任务如何流转</h2>
        <ol class="flow">{project.flow.map((step, index) => <li><span>0{index + 1}</span><strong>{step}</strong></li>)}</ol>
      </section>

      <section class="content-section evidence-section">
        <div><h2>如何验证它</h2><ul>{project.proof.map((item) => <li>{item}</li>)}</ul></div>
        <aside><h2>能力边界</h2><ul>{project.boundaries.map((item) => <li>{item}</li>)}</ul></aside>
      </section>
    </article>
  </div>
</BaseLayout>

<style>
  .detail-shell { max-width: 64rem; padding-block: 2.5rem 7rem; }
  .back-link { color: var(--muted-text); font-size: .78rem; text-decoration: none; }
  .back-link:hover { color: var(--primary); }
  .project-header { padding: 2.5rem 0 2rem; }
  h1 { margin: 0; font-family: var(--font-brand); font-size: clamp(2.3rem, 5vw, 3.4rem); font-weight: 680; letter-spacing: -.025em; }
  .project-header > p { max-width: 44rem; margin-top: .65rem; color: var(--muted-text); font-size: 1.08rem; line-height: 1.65; }
  .project-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.4rem; }
  .project-actions a, .project-actions > span { border-radius: 999px; color: var(--primary); padding: .65rem .9rem; font-size: .76rem; font-weight: 650; }
  .project-actions a { text-decoration: none; }
  .project-actions a.primary { color: var(--primary-contrast); background: var(--primary); }
  .project-actions > span { border: 1px solid var(--hairline); color: var(--muted-text); }
  .overview { border: 1px solid var(--hairline); border-radius: var(--radius-2xl); background: color-mix(in srgb, var(--surface) 62%, transparent); padding: clamp(1.5rem, 4vw, 2.5rem); box-shadow: var(--shadow-sm); }
  .overview > p { color: var(--muted-text); line-height: 1.8; }
  .tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.2rem; }
  .tags span { border-radius: 999px; color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); padding: .34rem .6rem; font-size: .68rem; }
  dl { display: grid; grid-template-columns: repeat(3, 1fr); margin: 2rem 0 0; border-top: 1px solid var(--hairline); padding-top: 1.5rem; }
  dl div + div { border-left: 1px solid var(--hairline); padding-left: 1.5rem; }
  dd { margin: 0; color: var(--primary); font-size: 1.2rem; font-weight: 700; }
  dt { margin-top: .3rem; color: var(--muted-text); font-size: .7rem; }
  .content-section { padding-top: 4rem; }
  .content-section > h2, .evidence-section h2 { margin: 0 0 1rem; font-family: var(--font-brand); font-size: 1.8rem; font-weight: 650; }
  .content-section > p { max-width: 50rem; margin: .8rem 0; line-height: 1.85; }
  .build-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .build-grid section { border: 1px solid var(--hairline); background: var(--surface-soft); padding: 1.5rem; }
  .shape-1 { border-radius: var(--radius-3xl) var(--radius-lg) var(--radius-2xl) var(--radius-xl); }
  .shape-2 { border-radius: var(--radius-xl) var(--radius-2xl) var(--radius-lg) var(--radius-3xl); }
  .shape-3 { border-radius: var(--radius-lg) var(--radius-3xl) var(--radius-xl) var(--radius-2xl); }
  .build-grid span { color: var(--primary); font-size: .68rem; font-weight: 650; }
  .build-grid h3 { margin-top: 1.2rem; font-family: var(--font-brand); font-size: 1.22rem; font-weight: 650; }
  .build-grid p { margin-top: .55rem; color: var(--muted-text); font-size: .86rem; line-height: 1.75; }
  .flow { display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; padding: 0; list-style: none; }
  .flow li { position: relative; border-top: 2px solid color-mix(in srgb, var(--primary) 30%, var(--hairline)); padding: 1rem .5rem 0 0; }
  .flow li::before { position: absolute; top: -.34rem; left: 0; width: .58rem; height: .58rem; border-radius: 50%; background: var(--primary); content: ''; }
  .flow span { display: block; color: var(--primary); font-size: .62rem; }
  .flow strong { display: block; margin-top: .35rem; font-size: .72rem; font-weight: 650; }
  .evidence-section { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .evidence-section > div, .evidence-section aside { border: 1px solid var(--hairline); border-radius: var(--radius-2xl); padding: 1.5rem; }
  .evidence-section aside { background: var(--surface-soft); }
  .evidence-section ul { display: grid; gap: .65rem; margin: 0; padding-left: 1.2rem; }
  .evidence-section li { color: var(--muted-text); font-size: .82rem; line-height: 1.75; }
  .evidence-section li::marker { color: var(--primary); }
  @media (max-width: 700px) { .detail-shell { padding-top: 1.5rem; } .build-grid, .evidence-section { grid-template-columns: 1fr; } dl { grid-template-columns: 1fr; } dl div + div { border-top: 1px solid var(--hairline); border-left: 0; margin-top: 1rem; padding: 1rem 0 0; } .flow { grid-template-columns: 1fr; } .flow li { border-top: 0; border-left: 2px solid color-mix(in srgb, var(--primary) 30%, var(--hairline)); padding: 0 0 1.2rem 1rem; } .flow li::before { top: .15rem; left: -.36rem; } }
</style>
