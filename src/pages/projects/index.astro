---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreviewV2 from '../../components/ProjectPreviewV2.astro';
import { profile } from '../../data/profile';
---

<BaseLayout title="项目" description="两个 AI Agent 项目，以及我怎样验证它们真正做到了什么。" active="/projects">
  <header class="page-head">
    <p class="eyebrow">SELECTED WORK · 02</p>
    <h1>我做过的两个<br /><em>Agent 项目。</em></h1>
    <div class="head-note">
      <p>它们解决的问题不同，但都在追问同一件事：模型做出的判断，怎样被约束、验证和追溯。</p>
      <span aria-hidden="true">从问题出发，不从技术名词出发 ↘</span>
    </div>
  </header>

  <section class="project-list" aria-label="项目列表">
    {profile.projects.map((project, index) => <ProjectPreviewV2 project={project} index={index + 1} />)}
  </section>

  <aside class="working-note">
    <span>still working on it</span>
    <p>这两个项目都还在继续迭代。案例页展示的是已经实现并核验的部分；计划中的能力不会被写成既成事实。</p>
  </aside>
</BaseLayout>

<style>
  .page-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .55fr); align-items: end; gap: 3rem; padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 8vw, 6.5rem); }
  .page-head > .eyebrow { grid-column: 1 / -1; }
  h1 { max-width: 13ch; font-size: clamp(2.8rem, 6.5vw, 5.6rem); font-weight: 710; letter-spacing: -.065em; line-height: 1.03; }
  h1 em { color: var(--color-primary-600); font-style: normal; }
  .head-note { max-width: 31rem; padding-bottom: .35rem; }
  .head-note p { color: var(--muted-text); font-size: .94rem; line-height: 1.9; }
  .head-note span { display: block; margin-top: 1.2rem; color: var(--color-primary-600); font-family: 'KaiTi', 'STKaiti', serif; font-size: .82rem; transform: rotate(-1deg); }
  .project-list { display: grid; gap: clamp(5.5rem, 12vw, 10rem); border-top: 1px solid var(--hairline); padding-top: clamp(4.5rem, 9vw, 7rem); }
  .working-note { display: grid; grid-template-columns: 10rem minmax(0, 38rem); gap: 2rem; border-top: 1px solid var(--hairline); margin-top: clamp(5rem, 11vw, 9rem); padding-top: 1.5rem; }
  .working-note span { color: var(--color-primary-600); font: 600 .63rem/1 var(--font-mono); letter-spacing: .06em; }
  .working-note p { color: var(--muted-text); font-size: .84rem; line-height: 1.85; }
  @media (max-width: 760px) { .page-head { grid-template-columns: 1fr; gap: 1.6rem; } .working-note { grid-template-columns: 1fr; gap: .75rem; } }
</style>
