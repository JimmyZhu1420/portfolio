---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
---

<BaseLayout title="项目" description="我开发和持续维护的 AI Agent 工程项目。" active="/projects">
  <div class="site-wrapper page-shell">
    <header class="page-header"><h1>项目</h1><p>我开发和持续维护的项目</p></header>
    <section class="projects" aria-label="项目列表">
      {profile.projects.map((project, index) => (
        <a class={`project-card shape-${index + 1}`} href={`/projects/${project.slug}`}>
          <h2>{project.name}</h2>
          <p>{project.tagline}</p>
          <div><span>{project.year}</span><span>{project.status}</span></div>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .page-shell { max-width: 64rem; padding-block: 3rem 7rem; }
  .page-header { padding: 1rem 0 2.5rem; }
  h1 { margin: 0; font-family: var(--font-brand); font-size: clamp(2.1rem, 5vw, 3rem); font-weight: 680; letter-spacing: -.025em; }
  .page-header p { margin-top: .6rem; color: var(--muted-text); font-size: 1rem; }
  .projects { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
  .project-card { display: flex; min-height: 15rem; flex-direction: column; border: 1px solid var(--hairline); color: inherit; background: var(--surface-soft); padding: 1.75rem; text-decoration: none; transition: transform .3s ease, box-shadow .3s ease; }
  .shape-1 { border-radius: var(--radius-3xl) var(--radius-lg) var(--radius-2xl) var(--radius-lg); }
  .shape-2 { border-radius: var(--radius-lg) var(--radius-2xl) var(--radius-lg) var(--radius-3xl); }
  .project-card:hover { transform: translateY(-.25rem); box-shadow: var(--shadow-md); }
  h2 { font-family: var(--font-brand); font-size: 1.65rem; font-weight: 650; transition: color .2s ease; }
  .project-card:hover h2 { color: var(--primary); }
  .project-card > p { margin-top: .65rem; color: var(--muted-text); line-height: 1.65; }
  .project-card > div { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1.5rem; color: var(--muted-text); font-size: .72rem; }
  @media (max-width: 700px) { .page-shell { padding-top: 2rem; } .projects { grid-template-columns: 1fr; } .project-card { min-height: 12rem; } }
</style>
