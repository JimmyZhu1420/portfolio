---
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
---

<BaseLayout
  title="项目"
  description="EvoAgent 与 OA Evidence Agent：围绕 Agent Runtime、可信检索、评测和可审计执行的两个完整工程案例。"
  active="/projects"
>
  <header class="projects-hero">
    <div class="hero-copy">
      <p class="eyebrow">SELECTED WORK</p>
      <h1>把 Agent 的想法，做成可以验证的系统。</h1>
      <p>
        这里不是技术名词的陈列，而是两个完整案例：它们分别处理代码审查中的运行时与评测问题，
        以及医疗研究场景中的证据链与安全边界。
      </p>
    </div>

    <nav class="case-index" aria-label="项目快捷导航">
      <p>CASE INDEX · {String(profile.projects.length).padStart(2, '0')}</p>
      <ol>
        {profile.projects.map((project, index) => (
          <li>
            <a href={`#${project.slug}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <span>
                <strong>{project.name}</strong>
                <small>{project.eyebrow}</small>
              </span>
              <i aria-hidden="true">↓</i>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </header>

  <section class="project-section" aria-labelledby="case-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">CASE STUDIES</p>
        <h2 id="case-title">两个项目，两条可靠性路径</h2>
      </div>
      <p>每个案例都按工程问题、系统实现、执行流程、验证证据与能力边界展开。</p>
    </div>

    <div class="project-list">
      {profile.projects.map((project, index) => (
        <div id={project.slug} class="project-anchor">
          <ProjectCard project={project} reverse={index % 2 === 1} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .projects-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(18rem, 0.68fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 7rem);
    min-height: 36rem;
    padding: clamp(5rem, 11vw, 8.5rem) 0 clamp(4rem, 8vw, 6.5rem);
  }

  .hero-copy h1 {
    max-width: 13ch;
    margin-top: 0.9rem;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 780;
    letter-spacing: -0.065em;
    line-height: 1.02;
  }

  .hero-copy > p:last-child {
    max-width: 43rem;
    margin-top: 1.6rem;
    color: var(--muted-text);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.9;
  }

  .case-index { border-top: 1px solid var(--hairline); }
  .case-index > p {
    padding: 1rem 0 0.75rem;
    color: var(--muted-text);
    font: 650 0.66rem/1 var(--font-mono);
    letter-spacing: 0.1em;
  }
  .case-index ol { margin: 0; padding: 0; list-style: none; }
  .case-index a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--hairline);
    color: inherit;
    padding: 1.15rem 0;
    text-decoration: none;
  }
  .case-index a > span:first-child {
    color: var(--color-primary-600);
    font: 650 0.67rem/1 var(--font-mono);
  }
  .case-index a > span:nth-child(2) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.25rem;
  }
  .case-index strong { font-size: 0.9rem; font-weight: 700; }
  .case-index small {
    overflow: hidden;
    color: var(--muted-text);
    font: 550 0.59rem/1.35 var(--font-mono);
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .case-index i {
    color: var(--muted-text);
    font-style: normal;
    transition: transform 160ms ease;
  }
  .case-index a:hover i { transform: translateY(0.2rem); }

  .project-section {
    border-top: 1px solid var(--hairline);
    padding: clamp(4rem, 9vw, 7.5rem) 0;
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2.5rem;
  }
  .section-heading h2 {
    max-width: 16ch;
    margin-top: 0.65rem;
    font-size: clamp(2rem, 4vw, 3.3rem);
    font-weight: 760;
    letter-spacing: -0.05em;
    line-height: 1.12;
  }
  .section-heading > p {
    max-width: 29rem;
    color: var(--muted-text);
    font-size: 0.9rem;
    line-height: 1.8;
  }
  .project-list { margin-top: 1rem; }
  .project-anchor { scroll-margin-top: 6rem; }

  @media (max-width: 820px) {
    .projects-hero {
      grid-template-columns: 1fr;
      align-items: start;
      min-height: auto;
    }
    .case-index { max-width: 38rem; }
    .section-heading {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
    }
  }

  @media (max-width: 520px) {
    .projects-hero { gap: 2.75rem; padding-block: 4.25rem 3.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-index i { transition: none; }
  }
</style>
