---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
---

<BaseLayout title="项目" description="我开发和持续维护的 AI Agent 工程项目。" active="/projects">
  <div class="projects-page">
    <header class="projects-hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="shell">
        <p data-reveal>SELECTED AI AGENT SYSTEMS</p>
        <h1 data-reveal>项目</h1>
        <div class="hero-bottom" data-reveal>
          <p>我围绕 Agent Runtime、可信 RAG 和评测可观测性，持续构建两个可以复现、验证和审计的工程项目。</p>
          <span>2026 · 上海</span>
        </div>
      </div>
    </header>

    <div class="projects-list shell" aria-label="项目列表">
      {profile.projects.map((project, index) => (
        <article class:list={['project-item', project.slug]} data-reveal>
          <a class="project-main" href={`/projects/${project.slug}`}>
            <div class="project-number">0{index + 1}</div>
            <div class="project-copy">
              <p>{project.eyebrow}</p>
              <h2>{project.name}</h2>
              <h3>{project.title}</h3>
              <span>查看项目 <b aria-hidden="true">›</b></span>
            </div>

            <div class="project-art" aria-hidden="true">
              {project.slug === 'evoagent' ? (
                <div class="evo-art">
                  <div class="evo-ring ring-a"></div><div class="evo-ring ring-b"></div>
                  <div class="evo-core"><strong>PR</strong><span>VERIFIED</span></div>
                  <i class="agent agent-a">S</i><i class="agent agent-b">R</i><i class="agent agent-c">V</i>
                </div>
              ) : (
                <div class="oa-art">
                  <div class="oa-core"><strong>E</strong><span>evidence</span></div>
                  <span class="oa-chip chip-a">Retrieve <i>✓</i></span>
                  <span class="oa-chip chip-b">Validate <i>✓</i></span>
                  <span class="oa-chip chip-c">Safety <i>✓</i></span>
                </div>
              )}
            </div>
          </a>

          <div class="project-facts">
            {project.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
            <div><strong>{project.year}</strong><span>{project.status}</span></div>
          </div>
        </article>
      ))}
    </div>

  </div>
</BaseLayout>

<style>
  .projects-page { background: #fff; }
  .projects-hero { position: relative; overflow: hidden; color: #f5f5f7; background: #000; padding: clamp(6rem, 10vw, 8rem) 0 4rem; isolation: isolate; }
  .hero-glow { position: absolute; z-index: -1; top: 30%; right: -18%; width: 46rem; height: 32rem; border-radius: 50%; background: radial-gradient(circle, rgb(38 126 255 / .26), rgb(131 73 255 / .12) 38%, transparent 70%); filter: blur(42px); }
  .projects-hero .shell > p, .projects-note p { margin: 0 0 1.5rem; color: #2997ff; font-size: .75rem; font-weight: 650; letter-spacing: .13em; }
  h1 { margin: 0; font-size: clamp(3rem, 5vw, 4rem); font-weight: 650; letter-spacing: -.06em; line-height: 1; }
  .hero-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 3rem; border-top: 1px solid rgb(255 255 255 / .16); margin-top: clamp(4rem, 8vw, 7rem); padding-top: 1.6rem; }
  .hero-bottom p { max-width: 38rem; margin: 0; color: #a1a1a6; font-size: clamp(1.05rem, 1.7vw, 1.3rem); line-height: 1.6; }
  .hero-bottom span { flex: none; color: #6e6e73; font: .68rem/1 var(--font-mono); letter-spacing: .08em; }
  .projects-list { display: grid; gap: 2rem; padding-block: clamp(5rem, 9vw, 8rem); }
  .project-item { overflow: hidden; border-radius: 2.75rem; background: #f5f5f7; }
  .project-main { position: relative; display: grid; min-height: 38rem; grid-template-columns: 4rem .9fr 1.1fr; overflow: hidden; color: #1d1d1f; padding: clamp(2rem, 4vw, 4rem); text-decoration: none; isolation: isolate; }
  .project-item.evoagent .project-main { color: #f5f5f7; background: linear-gradient(145deg, #17171a, #050506); }
  .project-item.evoagent .project-main::before { position: absolute; z-index: -1; top: -35%; right: -20%; width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(0 113 227 / .31), transparent 65%); content: ''; filter: blur(15px); }
  .project-number { color: #86868b; font: 500 .7rem/1 var(--font-mono); letter-spacing: .08em; }
  .project-copy { position: relative; z-index: 3; align-self: center; }
  .project-copy > p { margin: 0 0 1rem; color: #0066cc; font-size: .68rem; font-weight: 650; letter-spacing: .11em; }
  .evoagent .project-copy > p { color: #2997ff; }
  .project-copy h2 { margin: 0; font-size: clamp(2.8rem, 4.5vw, 3.8rem); font-weight: 650; letter-spacing: -.058em; line-height: 1; }
  .project-copy h3 { max-width: 30rem; margin: 1.5rem 0 0; color: #6e6e73; font-size: clamp(1.05rem, 1.7vw, 1.35rem); font-weight: 500; line-height: 1.45; }
  .evoagent .project-copy h3 { color: #a1a1a6; }
  .project-copy > span { display: inline-block; margin-top: 1.75rem; color: #0066cc; font-size: 1rem; }
  .evoagent .project-copy > span { color: #2997ff; }
  .project-copy b { display: inline-block; margin-left: .2rem; font-size: 1.3rem; font-weight: 400; transition: transform .35s var(--ease-premium); }
  .project-main:hover .project-copy b { transform: translateX(5px); }
  .project-art { position: relative; min-height: 26rem; transition: transform .8s var(--ease-premium); }
  .project-main:hover .project-art { transform: translate3d(0, -8px, 0) scale(1.015); }
  .evo-art, .oa-art { position: absolute; inset: 0; }
  .evo-ring { position: absolute; top: 50%; left: 50%; border: 1px solid rgb(120 188 255 / .24); border-radius: 50%; transform: translate(-50%, -50%) rotateX(64deg); }
  .ring-a { width: 82%; aspect-ratio: 1; animation: ring-spin 15s linear infinite; }
  .ring-b { width: 58%; aspect-ratio: 1; transform: translate(-50%, -50%) rotateY(68deg) rotateZ(20deg); animation: ring-spin-alt 11s linear infinite; }
  .evo-core { position: absolute; top: 50%; left: 50%; display: grid; width: 8rem; aspect-ratio: 1; place-items: center; border: 1px solid rgb(255 255 255 / .28); border-radius: 50%; background: radial-gradient(circle at 35% 25%, #d5f0ff, #368af0 18%, #101831 57%, #050506 78%); box-shadow: 0 0 60px rgb(37 125 255 / .38); transform: translate(-50%, -50%); }
  .evo-core strong { font-size: 1.2rem; letter-spacing: -.03em; }
  .evo-core span { position: absolute; bottom: 1.8rem; color: #8fc5ff; font: .43rem/1 var(--font-mono); letter-spacing: .12em; }
  .agent { position: absolute; display: grid; width: 2.2rem; height: 2.2rem; place-items: center; border: 1px solid rgb(255 255 255 / .2); border-radius: 50%; color: #fff; background: rgb(15 25 47 / .86); box-shadow: 0 0 20px rgb(41 151 255 / .28); font: normal 600 .58rem/1 var(--font-mono); animation: agent-float 4s ease-in-out infinite; }
  .agent-a { top: 18%; left: 14%; }
  .agent-b { top: 19%; right: 9%; animation-delay: -1.3s; }
  .agent-c { right: 17%; bottom: 13%; animation-delay: -2.5s; }
  .oa-art::before { position: absolute; top: 50%; left: 50%; width: 90%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgb(0 113 227 / .16), rgb(148 92 255 / .1) 40%, transparent 68%); content: ''; filter: blur(16px); transform: translate(-50%, -50%); }
  .oa-core { position: absolute; top: 50%; left: 50%; display: flex; width: 10rem; aspect-ratio: 1; align-items: center; justify-content: center; flex-direction: column; border: 1px solid rgb(255 255 255 / .94); border-radius: 50%; background: rgb(255 255 255 / .62); box-shadow: 0 24px 70px rgb(70 104 162 / .18), inset 0 1px 18px #fff; transform: translate(-50%, -50%); backdrop-filter: blur(20px); }
  .oa-core::before, .oa-core::after { position: absolute; border: 1px solid rgb(0 113 227 / .16); border-radius: 50%; content: ''; animation: oa-pulse 5s ease-in-out infinite; }
  .oa-core::before { inset: -2.4rem; }
  .oa-core::after { inset: -4.7rem; animation-delay: -1.8s; }
  .oa-core strong { color: #0066cc; font-size: 2.1rem; font-weight: 600; }
  .oa-core span { color: #6e6e73; font: .5rem/1 var(--font-mono); letter-spacing: .11em; }
  .oa-chip { position: absolute; z-index: 2; display: flex; align-items: center; gap: .5rem; border: 1px solid #fff; border-radius: 999px; background: rgb(255 255 255 / .74); padding: .7rem .9rem; box-shadow: 0 16px 36px rgb(52 89 146 / .12); font-size: .7rem; font-weight: 550; backdrop-filter: blur(18px); }
  .oa-chip i { display: grid; width: 1.1rem; height: 1.1rem; place-items: center; border-radius: 50%; color: #fff; background: #34c759; font-size: .52rem; font-style: normal; }
  .chip-a { top: 16%; left: 5%; }
  .chip-b { top: 20%; right: 0; }
  .chip-c { right: 8%; bottom: 13%; }
  .project-facts { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgb(0 0 0 / .08); padding: 1.8rem clamp(2rem, 4vw, 4rem); }
  .evoagent .project-facts { color: #f5f5f7; background: #0a0a0b; border-color: rgb(255 255 255 / .08); }
  .project-facts div { display: flex; flex-direction: column; gap: .35rem; }
  .project-facts strong { font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 600; letter-spacing: -.035em; }
  .project-facts span { color: #86868b; font-size: .68rem; line-height: 1.35; }
  .projects-note { color: #f5f5f7; background: #000; padding: clamp(7rem, 12vw, 11rem) 0; text-align: center; }
  .projects-note h2 { margin: 0; font-size: clamp(3rem, 6.7vw, 6rem); font-weight: 650; letter-spacing: -.064em; line-height: .98; }
  .projects-note a { display: inline-block; margin-top: 2.2rem; color: #2997ff; font-size: 1rem; text-decoration: none; }
  .projects-note a span { margin-left: .2rem; font-size: 1.3rem; }
  @keyframes ring-spin { to { rotate: 360deg; } }
  @keyframes ring-spin-alt { to { rotate: -360deg; } }
  @keyframes agent-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -9px; } }
  @keyframes oa-pulse { 0%, 100% { opacity: .35; transform: scale(.96); } 50% { opacity: 1; transform: scale(1.04); } }
  @media (max-width: 860px) {
    .project-main { min-height: 51rem; grid-template-columns: 3rem 1fr; }
    .project-art { grid-column: 1 / -1; min-height: 24rem; }
  }
  @media (max-width: 620px) {
    .projects-hero { padding-top: 6rem; }
    h1 { font-size: clamp(2.8rem, 14vw, 3.6rem); }
    .hero-bottom { align-items: flex-start; flex-direction: column; }
    .project-item { border-radius: 2rem; }
    .project-main { min-height: 45rem; grid-template-columns: 1fr; padding: 1.75rem 1.35rem; }
    .project-number { display: none; }
    .project-copy h2 { font-size: 2.75rem; }
    .project-art { min-height: 21rem; }
    .project-facts { grid-template-columns: repeat(2, 1fr); gap: 1.3rem; padding: 1.5rem 1.35rem; }
    .oa-chip { font-size: .58rem; }
  }
</style>
